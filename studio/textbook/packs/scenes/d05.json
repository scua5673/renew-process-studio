ue":"#234f83","red":"#b54c46"},"teamTxtC":{"blue":"#ffffff","red":"#ffffff","yellow":"#ffffff"},"chip3d":false,"tokV":2,"tokShape":"circle","players":[{"id":1,"num":"B1","team":"blue","pos":"","color":null,"x":318.75,"y":231.4},{"id":2,"num":"B2","team":"blue","pos":"","color":null,"x":381.75,"y":514.9},{"id":3,"num":"B3","team":"blue","pos":"","color":null,"x":618,"y":212.5},{"id":4,"num":"R1","team":"red","pos":"","color":null,"x":436.875,"y":212.5},{"id":5,"num":"R2","team":"red","pos":"","color":null,"x":515.625,"y":351.1},{"id":6,"num":"R3","team":"red","pos":"","color":null,"x":539.25,"y":540.1},{"id":7,"num":"N1","team":"yellow","pos":"","color":null,"x":192.75,"y":370},{"id":8,"num":"N2","team":"yellow","pos":"","color":null,"x":917.25,"y":370}],"ball":{"x":335.75,"y":248.4,"scale":0.38},"drawings":[{"type":"rectline","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":161.25,"y":55},{"x":948.75,"y":685}]},{"type":"line","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":555,"y":55},{"x":555,"y":685}]},{"type":"dashline","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":240,"y":55},{"x":240,"y":685}]},{"type":"dashline","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":870,"y":55},{"x":870,"y":685}]},{"type":"pass","color":"#234f83","lw":1,"op":1,"pts":[{"x":318.75,"y":231.4},{"x":192.75,"y":370}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":515.625,"y":212.5},{"x":436.875,"y":212.5}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":618,"y":357.4},{"x":515.625,"y":351.1}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":460.5,"y":420.4},{"x":381.75,"y":514.9}]}],"equipment":[]},"cap":"다른 조건 · 전방이 닫히면 시작 중립에게 돌아가 새 각도를 만들 수 있습니다.","hold":2.5,"dur":1.3}],"overview":"선수·공·이동은 원리를 설명하기 위한 가상 배치입니다. 세 그림은 학습용 조건 비교이며 실제 경기의 좌표·거리·시간을 측정한 자료가 아닙니다. 각 그림의 흰 공은 첫 실선 패스의 출발점이고, 실선은 가능한 패스 연결, 점선은 기본 배치에서 바뀐 선수 위치를 뜻합니다. 세 그림을 끊김 없는 연속 장면으로 읽지 않습니다. 구체적인 운영은 연결된 공통 훈련 카드를 따릅니다.\n\n목표: 상대가 접근했을 때 연결·운반·재순환 중 가능한 선택을 고른다.","setup":"양 끝에 중립 1명씩, 중앙에 각 팀 3명. 중립은 소유 팀을 돕지만 중앙으로 들어오지 않습니다. 끝 구역 깊이 3m는 전체 길이에 포함됩니다. 기본안에서는 끝 중립만 해당 구역에 들어가며 필드 선수는 구역 안으로 들어가지 않습니다. 중립은 자유 터치이고 상대는 중앙에서 패스 길을 차단합니다.\n준비물: 공 4개, 중립 끝 구역을 표시할 콘, 조끼 세 색.","method":"시작: 각 세트 첫 소유는 파랑·빨강이 번갈아 맡습니다. 파랑은 왼쪽 중립에서 오른쪽으로, 빨강은 반대 방향으로 시작하며 진행 중 방향은 득점 규칙을 따릅니다.\n\n끝과 끝을 연결하면 1점입니다. 상대를 반드시 유인하거나 특정 선수에게 먼저 패스할 의무는 없습니다.\n수비가 전진하지 않으면 운반해도 됩니다. 압박이 강하면 시작 중립에게 돌아갈 수 있습니다.\n탈취하면 자기 팀의 공격 방향으로 전진합니다. 득점하면 양 팀의 공격 방향을 뒤집고 같은 팀이 이어갑니다. 아웃이면 공을 내보내지 않은 팀의 시작 중립에게 줍니다.\n중립끼리의 직접 패스로는 점수를 얻지 못합니다. 시작 또는 득점 뒤에는 필드 선수가 적어도 한 번 받은 뒤 상대 끝 중립에게 연결해야 합니다. 탈취하면 현재 팀의 목표 끝을 공격하고, 득점 뒤에는 두 팀 모두 목표 끝을 바꿉니다.\n이 축소 게임은 오프사이드를 적용하지 않습니다. 실제 경기의 최종 수비선과 출발 시점은 별도로 확인합니다.\n반칙은 피해 팀이 현재 자기 시작 쪽 중립에게서 재개합니다. 재시작 첫 패스 때 상대는 수신자에게서 3m 떨어진 뒤 자유롭게 압박합니다.\n\n매 세트 중립 2명을 서로 다른 팀의 선수와 교대하고 공격 방향을 바꿉니다.","coaching":"유인하려고 계속 멈춰 있다 → 상대가 나왔는지부터 확인합니다. 나오지 않는 상대를 기다리는 대신 운반하는 선택을 비교합니다.\n\n상대가 나오자 준비 없이 급하게 준다 → 수신자가 다음 길을 준비했는지 패스 전에 확인하게 합니다.","func":"관찰: 상대 전진 여부, 그때 열린 길, 실제 선택을 한 묶음으로 적습니다.\n\n전이: 후방의 기다림을 목표로 삼지 말고 상대 반응으로 길이 바뀐 경기 장면을 확인합니다.","prog":"쉽게: 전체 길이를 34m로 늘리고 양 끝 3m 구역은 유지합니다. 중앙 길이는 24m에서 28m가 됩니다. 넓어진 공간에서 수신 준비가 어떻게 달라지는지 봅니다.\n\n어렵게: 역할 교환 변형: 득점 중립이 중앙으로 들어오면 패스한 선수가 즉시 그 끝 구역을 맡습니다. 중립이던 선수는 패스한 선수의 팀에 합류해 3v3+2를 유지합니다. 득점 뒤 방향 전환은 기본안과 같습니다.","minutes":4,"sets":3,"source":{"url":"https://weloveprocess.netlify.app/textbook/practice/d05/","scene":"d05"},"trainingArea":{"width":30,"height":24},"textbookItem":"scene-d05","textbookRevision":2,"animIdx":0}]}
