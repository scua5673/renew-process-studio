f","yellow":"#ffffff"},"chip3d":false,"tokV":2,"tokShape":"circle","players":[{"id":1,"num":"B1","team":"blue","pos":"","color":null,"x":318.75,"y":231.4},{"id":2,"num":"B2","team":"blue","pos":"","color":null,"x":381.75,"y":514.9},{"id":3,"num":"B3","team":"blue","pos":"","color":null,"x":618,"y":212.5},{"id":4,"num":"R1","team":"red","pos":"","color":null,"x":436.875,"y":212.5},{"id":5,"num":"R2","team":"red","pos":"","color":null,"x":515.625,"y":351.1},{"id":6,"num":"R3","team":"red","pos":"","color":null,"x":539.25,"y":540.1},{"id":7,"num":"N1","team":"yellow","pos":"","color":null,"x":192.75,"y":370},{"id":8,"num":"N2","team":"yellow","pos":"","color":null,"x":917.25,"y":370}],"ball":{"x":335.75,"y":248.4,"scale":0.38},"drawings":[{"type":"rectline","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":161.25,"y":55},{"x":948.75,"y":685}]},{"type":"line","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":555,"y":55},{"x":555,"y":685}]},{"type":"dashline","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":224.25,"y":55},{"x":224.25,"y":685}]},{"type":"dashline","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":885.75,"y":55},{"x":885.75,"y":685}]},{"type":"pass","color":"#234f83","lw":1,"op":1,"pts":[{"x":318.75,"y":231.4},{"x":192.75,"y":370}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":515.625,"y":212.5},{"x":436.875,"y":212.5}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":618,"y":357.4},{"x":515.625,"y":351.1}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":460.5,"y":420.4},{"x":381.75,"y":514.9}]}],"equipment":[]},"cap":"다른 조건 · 전방이 닫히면 시작 중립에게 돌아가 새 각도를 만들 수 있습니다.","hold":2.5,"dur":1.3}],"overview":"선수·공·이동은 원리를 설명하기 위한 가상 배치입니다. 세 그림은 학습용 조건 비교이며 실제 경기의 좌표·거리·시간을 측정한 자료가 아닙니다. 구체적인 운영은 아래 훈련 카드를 따릅니다.\n\n목표: 상대가 접근했을 때 연결·운반·재순환 중 가능한 선택을 고른다.","setup":"양 끝에 중립 1명씩, 중앙에 각 팀 3명. 중립은 소유 팀을 돕지만 중앙으로 들어오지 않습니다.\n준비물: 공 4개, 중립 끝 구역을 표시할 콘, 조끼 세 색.","method":"시작: 한쪽 중립의 패스로 시작해 반대 끝 중립을 목표로 합니다. 다음 재시작에서는 반대 팀이 먼저 소유합니다.\n\n끝과 끝을 연결하면 1점입니다. 상대를 반드시 유인하거나 특정 선수에게 먼저 패스할 의무는 없습니다.\n수비가 전진하지 않으면 운반해도 됩니다. 압박이 강하면 시작 중립에게 돌아갈 수 있습니다.\n탈취하면 자기 팀의 공격 방향으로 전진합니다. 득점하면 양 팀의 공격 방향을 뒤집고 같은 팀이 이어갑니다. 아웃이면 공을 내보내지 않은 팀의 시작 중립에게 줍니다.\n\n매 세트 중립 2명을 서로 다른 팀의 선수와 교대하고 공격 방향을 바꿉니다.","coaching":"유인하려고 계속 멈춰 있다 → 상대가 나왔는지부터 확인합니다. 나오지 않는 상대를 기다리는 대신 운반하는 선택을 비교합니다.\n\n상대가 나오자 준비 없이 급하게 준다 → 수신자가 다음 길을 준비했는지 패스 전에 확인하게 합니다.","func":"관찰: 상대 전진 여부, 그때 열린 길, 실제 선택을 한 묶음으로 적습니다.\n\n전이: 후방의 기다림을 목표로 삼지 말고 상대 반응으로 길이 바뀐 경기 장면을 확인합니다.","prog":"쉽게: 중앙 공간을 길이 34m로 늘려 수신 준비 시간을 줍니다.\n\n어렵게: 마지막 세트에서 끝 중립이 패스를 받자마자 중앙으로 들어오고 패스한 선수가 끝 역할을 이어받게 합니다.","minutes":4,"sets":3,"source":{"url":"https://weloveprocess.netlify.app/textbook/practice/d05/","scene":"d05"},"trainingArea":{"width":30,"height":24},"textbookItem":"scene-d05","textbookRevision":1,"animIdx":0}]}
