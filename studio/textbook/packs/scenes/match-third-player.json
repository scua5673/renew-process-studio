N":1,"pitchTheme":"train","label":"num","lines":true,"gridType":"off","tokenScale":1.5,"tokV":2,"tokShape":"circle","players":[{"id":1,"team":"blue","num":"A","pos":"","x":300,"y":370,"color":null},{"id":2,"team":"blue","num":"B","pos":"","x":500,"y":380,"color":null},{"id":3,"team":"blue","num":"C","pos":"","x":644,"y":326,"color":null},{"id":4,"team":"blue","num":"D","pos":"","x":793,"y":120,"color":null},{"id":5,"team":"blue","num":"E","pos":"","x":610,"y":500,"color":null},{"id":6,"team":"red","num":"X","pos":"","x":520,"y":375,"color":null},{"id":7,"team":"red","num":"Y","pos":"","x":643,"y":450,"color":null},{"id":8,"team":"red","num":"Z","pos":"","x":850,"y":360,"color":null}],"ball":{"x":660,"y":310,"scale":0.38},"drawings":[{"type":"pass","color":"#b48018","lw":1,"op":1,"pts":[{"x":660,"y":310},{"x":800,"y":120}]},{"type":"run","color":"#66869d","lw":1,"op":0.8,"pts":[{"x":500,"y":380},{"x":530,"y":390}]},{"type":"run","color":"#66869d","lw":1,"op":0.8,"pts":[{"x":644,"y":326},{"x":700,"y":330}]}],"equipment":[]},"dur":1.3,"hold":2.5,"cap":"연결 · 브로조비치 역할의 선수는 반대 방향으로 움직여 전방을 향해 받습니다."},{"snap":{"pitchSpec":"fifa","orientation":"h","area":"full","pitchView":"full","pvSide":"own","fieldMode":"standard","spFlip":false,"pitchN":1,"pitchTheme":"train","label":"num","lines":true,"gridType":"off","tokenScale":1.5,"tokV":2,"tokShape":"circle","players":[{"id":1,"team":"blue","num":"A","pos":"","x":300,"y":370,"color":null},{"id":2,"team":"blue","num":"B","pos":"","x":530,"y":390,"color":null},{"id":3,"team":"blue","num":"C","pos":"","x":700,"y":330,"color":null},{"id":4,"team":"blue","num":"D","pos":"","x":784,"y":136,"color":null},{"id":5,"team":"blue","num":"E","pos":"","x":610,"y":500,"color":null},{"id":6,"team":"red","num":"X","pos":"","x":580,"y":390,"color":null},{"id":7,"team":"red","num":"Y","pos":"","x":655,"y":450,"color":null},{"id":8,"team":"red","num":"Z","pos":"","x":850,"y":360,"color":null}],"ball":{"x":800,"y":120,"scale":0.38},"drawings":[],"equipment":[]},"dur":1.3,"hold":2.5,"cap":"확장 · 세 번째 수신 뒤 운반과 측면 연결 중 다음 선택을 확인합니다."}],"animIdx":0,"folder":"교과서 · 실제 경기 학습","tags":["교과서","경기 사례","학습 도식"],"overview":"공식 경기 분석을 바탕으로 PROCESS가 만든 학습용 관계 도식입니다. 필요한 선수만 표시했으며 문자 표시는 등번호가 아닙니다. 위치·거리·이동 시간과 패스 경로는 실측 재현이 아닙니다. 마지막 단계의 검토와 조건 비교는 학습 질문입니다.","method":"FIFA는 로브렌의 전진 패스를 받으러 내려오는 모드리치와, 반대 방향으로 전진하는 브로조비치의 관계를 분석했습니다. 모드리치에게 유스타키우가 붙자 모드리치는 첫 터치로 공을 돌려 브로조비치의 진행 방향에 연결했습니다.\n\n브로조비치는 앞으로 향한 상태로 받아 짧게 운반한 뒤 페리시치에게 연결했습니다. 이 장면의 세 번째 선수 연결은 무조건 “앞으로, 뒤로, 다시 앞으로”의 순서를 거치지 않았습니다.\n\n학습 단계\n1. 접근 · 로브렌 역할의 패서 앞에서 모드리치 역할의 선수가 내려옵니다.\n2. 유도 · 유스타키우 역할의 수비가 따라오며 그 뒤의 공간이 생깁니다.\n3. 연결 · 브로조비치 역할의 선수는 반대 방향으로 움직여 전방을 향해 받습니다.\n4. 확장 · 세 번째 수신 뒤 운반과 측면 연결 중 다음 선택을 확인합니다.","coaching":"PROCESS 비교 실습\n두 번째 선수에게 밀착한다 → 세 번째 선수의 출발을 패스 직전에 맞춘다 → 원터치 연결이 전진하는 동료의 발앞에 도착하는가\n\n세 번째 선수의 길을 먼저 막는다 → 두 번째 선수의 턴이나 되돌리기를 허용한다 → 외운 패턴을 포기하고 다른 출구를 찾는가\n\n패서·연결자·전진자와 수비 2명을 두고 끝선을 넘어 받는 3v2를 진행합니다. 수비 한 명은 연결자를 따라가거나 세 번째 선수의 길을 막을 수 있습니다. 공격은 패스 세 번을 의무화하지 않고, 누가 전방을 향해 자유롭게 받았는지로 성공을 판단합니다.","source":{"url":"https://www.fifatrainingcentre.com/en/game/game-analysis/world-class-tactics/croatia-evolving-third-player-combinations.php","fixture":"크로아티아 4–1 캐나다","date":"2022-11-27","locator":"Example 2 · First-touch flick under tight pressure","article":"https://weloveprocess.netlify.app/focus/third-player/","scene":"match-third-player"},"textbookItem":"scene-match-third-player","textbookRevision":1}]}
