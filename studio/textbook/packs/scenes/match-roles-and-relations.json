":"C","pos":"","x":220,"y":220,"color":null},{"id":4,"team":"blue","num":"D","pos":"","x":700,"y":630,"color":null},{"id":5,"team":"red","num":"X","pos":"","x":393,"y":323,"color":null},{"id":6,"team":"red","num":"Y","pos":"","x":613,"y":430,"color":null},{"id":7,"team":"red","num":"Z","pos":"","x":780,"y":350,"color":null}],"ball":{"x":480,"y":460,"scale":0.38},"drawings":[{"type":"pass","color":"#b48018","lw":1,"op":1,"pts":[{"x":480,"y":460},{"x":660,"y":480}]},{"type":"run","color":"#66869d","lw":1,"op":0.8,"pts":[{"x":533,"y":470},{"x":644,"y":496}]},{"type":"run","color":"#66869d","lw":1,"op":0.8,"pts":[{"x":464,"y":476},{"x":500,"y":390}]}],"equipment":[]},"dur":1.3,"hold":2.5,"cap":"연결 · 내려온 선수의 첫 터치가 다음 전진을 볼 수 있게 하는지 확인합니다."},{"snap":{"pitchSpec":"fifa","orientation":"h","area":"full","pitchView":"full","pvSide":"own","fieldMode":"standard","spFlip":false,"pitchN":1,"pitchTheme":"train","label":"num","lines":true,"gridType":"off","tokenScale":1.5,"tokV":2,"tokShape":"circle","players":[{"id":1,"team":"blue","num":"A","pos":"","x":644,"y":496,"color":null},{"id":2,"team":"blue","num":"B","pos":"","x":500,"y":390,"color":null},{"id":3,"team":"blue","num":"C","pos":"","x":220,"y":220,"color":null},{"id":4,"team":"blue","num":"D","pos":"","x":700,"y":630,"color":null},{"id":5,"team":"red","num":"X","pos":"","x":390,"y":350,"color":null},{"id":6,"team":"red","num":"Y","pos":"","x":630,"y":430,"color":null},{"id":7,"team":"red","num":"Z","pos":"","x":780,"y":350,"color":null}],"ball":{"x":660,"y":480,"scale":0.38},"drawings":[],"equipment":[]},"dur":1.3,"hold":2.5,"cap":"재정렬 · 공을 보낸 뒤에도 후방 출구와 공 뒤의 지원을 다시 맡습니다."}],"animIdx":0,"folder":"교과서 · 실제 경기 학습","tags":["교과서","경기 사례","학습 도식"],"overview":"공식 경기 분석을 바탕으로 PROCESS가 만든 학습용 관계 도식입니다. 필요한 선수만 표시했으며 문자 표시는 등번호가 아닙니다. 위치·거리·이동 시간과 패스 경로는 실측 재현이 아닙니다. 마지막 단계의 검토와 조건 비교는 학습 질문입니다.","method":"UEFA 관찰자 데이비드 모예스는 인터의 센터백과 미드필더가 빌드업 중 위치를 바꾼 점에 주목했습니다. 센터백이 측면이나 중앙으로 전진하면 미드필더가 내려와 공격의 시작점을 맡았습니다. 바렐라는 연결과 전진에서 중요한 역할을 했습니다.\n\n공이 없을 때 인터는 5-3-2 조직을 만들었고, 양쪽 센터백이 시티의 라인 사이 선수에게 나가는 역할도 수행했습니다. 같은 선수가 공격과 수비에서 같은 좌표에 머문 것은 아니었습니다.\n\n학습 단계\n1. 시작 · 후방에서 출발하는 센터백과 내려올 미드필더를 짝으로 표시합니다.\n2. 교환 중 · 센터백이 앞선으로 이동하는 동안 미드필더가 연결 각도를 만듭니다.\n3. 연결 · 내려온 선수의 첫 터치가 다음 전진을 볼 수 있게 하는지 확인합니다.\n4. 재정렬 · 공을 보낸 뒤에도 후방 출구와 공 뒤의 지원을 다시 맡습니다.","coaching":"PROCESS 비교 실습\n상대가 전진하는 센터백을 따라간다 → 내려오는 미드필더의 수신 위치를 옆으로 넓힌다 → 상대 이동으로 비워진 통로를 사용할 수 있는가\n\n상대가 지역을 지킨다 → 교환을 멈추고 앞선의 자유 선수를 찾는다 → 움직임 자체를 완료하려다 패스 시점을 놓치지 않는가\n\n후방 3명·중원 2명·앞선 2명과 골키퍼를 두고 상대의 압박을 통과해 목표 구역으로 전진합니다. 센터백 한 명이 이동할 때 교환 상대를 미리 지정하는 라운드와 자유롭게 인수하는 라운드를 비교합니다. 코치는 “누가 내려왔나” 다음에 “어떤 연결 과제를 맡았나”를 묻습니다.","source":{"url":"https://www.uefa.com/uefachampionsleague/news/0291-1be497954068-dcc483eb426a-1000--in-the-zone-how-inter-stifled-city/","fixture":"맨체스터 시티 0–0 인터","date":"2024-09-18","locator":"Inter’s build-up play · Video 1","article":"https://weloveprocess.netlify.app/focus/roles-and-relations/","scene":"match-roles-and-relations"},"textbookItem":"scene-match-roles-and-relations","textbookRevision":1}]}
