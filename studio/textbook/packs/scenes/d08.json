39.8,"y":214},{"x":772.8,"y":190}]}],"equipment":[]},"cap":"조정 · 가까운 도착과 먼 쪽 도착, 뒤의 지원을 나눠 준비합니다.","hold":2.5,"dur":1.3},{"snap":{"pitchSpec":"grid70","orientation":"h","area":"full","pitchView":"full","pvSide":"own","fieldMode":"standard","spFlip":false,"pitchN":1,"pitchTheme":"train","label":"num","lines":true,"gridType":"off","tokenScale":1.2,"teamColors":{"blue":"#234f83","red":"#b54c46","yellow":"#b38c35"},"gkColors":{"blue":"#234f83","red":"#b54c46"},"teamTxtC":{"blue":"#ffffff","red":"#ffffff","yellow":"#ffffff"},"chip3d":false,"tokV":2,"tokShape":"circle","players":[{"id":1,"num":"B1","team":"blue","pos":"","color":null,"x":390,"y":190},{"id":2,"num":"B2","team":"blue","pos":"","color":null,"x":528.6,"y":442},{"id":3,"num":"B3","team":"blue","pos":"","color":null,"x":654,"y":400},{"id":4,"num":"B4","team":"blue","pos":"","color":null,"x":680.4,"y":202},{"id":5,"num":"B5","team":"blue","pos":"","color":null,"x":660.6,"y":580},{"id":6,"num":"R1","team":"red","pos":"","color":null,"x":574.8,"y":250},{"id":7,"num":"R2","team":"red","pos":"","color":null,"x":607.8,"y":520},{"id":8,"num":"R3","team":"red","pos":"","color":null,"x":739.8,"y":214},{"id":9,"num":"R4","team":"red","pos":"","color":null,"x":746.4,"y":358},{"id":10,"num":"R5","team":"red","pos":"","color":null,"x":733.2,"y":478},{"id":11,"num":"GK1","team":"blue","pos":"GK","color":"#263b31","x":251.4,"y":370},{"id":12,"num":"GK2","team":"red","pos":"GK","color":"#263b31","x":858.6,"y":370}],"ball":{"x":750.2,"y":495,"scale":0.38},"drawings":[{"type":"rectline","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":225,"y":70},{"x":885,"y":670}]},{"type":"line","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":555,"y":70},{"x":555,"y":670}]},{"type":"dashline","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":225,"y":145},{"x":885,"y":145}]},{"type":"dashline","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":225,"y":595},{"x":885,"y":595}]},{"type":"dashline","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":375,"y":70},{"x":375,"y":670}]},{"type":"dashline","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":735,"y":70},{"x":735,"y":670}]},{"type":"rectline","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":211.8,"y":332.5},{"x":225,"y":407.5}]},{"type":"rectline","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":225,"y":280},{"x":315,"y":460}]},{"type":"rectline","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":885,"y":332.5},{"x":898.2,"y":407.5}]},{"type":"rectline","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":795,"y":280},{"x":885,"y":460}]},{"type":"pass","color":"#234f83","lw":1,"op":1,"pts":[{"x":733.2,"y":478},{"x":607.8,"y":520}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":409.8,"y":532},{"x":528.6,"y":442}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":555,"y":340},{"x":654,"y":400}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":739.8,"y":538},{"x":733.2,"y":478}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":680.4,"y":526},{"x":660.6,"y":580}]}],"equipment":[]},"cap":"소유 변화 · 걷어낸 공을 상대가 잡았을 때 B2의 뒤 준비도 확인합니다.","hold":2.5,"dur":1.3}],"overview":"선수·공·이동은 원리를 설명하기 위한 가상 배치입니다. 세 그림은 학습용 조건 비교이며 실제 경기의 좌표·거리·시간을 측정한 자료가 아닙니다. 각 그림의 흰 공은 첫 실선 패스의 출발점이고, 실선은 가능한 패스 연결, 점선은 기본 배치에서 바뀐 선수 위치를 뜻합니다. 세 그림을 끊김 없는 연속 장면으로 읽지 않습니다. 구체적인 운영은 연결된 공통 훈련 카드를 따릅니다.\n\n목표: 마지막 패스를 받을 공간·시점과 박스 밖 대비를 연결한다.","setup":"각 팀 필드 5명+골키퍼 1명으로 총 12명. 참고 구역은 위치를 읽는 선이며 출입 인원을 제한하지 않습니다. 골키퍼의 손 사용 범위는 골라인부터 6m×골문 중심 폭 12m의 표시 구역입니다. 동료가 의도적으로 발로 준 공은 손으로 잡지 않습니다. 구역은 이 축소 게임의 운영선입니다. 전술판의 골문 폭은 5m 예시이며 현장 골문에 맞춰 조정합니다.\n준비물: 골대 2개, 공 6개, 양 측면 5m 통로와 골대 앞 10m 참고 구역 콘.","method":"시작: 각 세트 첫 공과 코치가 멈춰 다시 설정하는 공은 측면에서 넣습니다. 그때 팀과 측면을 번갈아 바꿉니다. 진행 중 아웃·득점은 아래 재시작 규칙을 따릅니다.\n\n득점은 1점이며 크로스 의무는 없습니다. 중앙 진입·컷백·재순환을 모두 허용합니다.\n수비가 되찾으면 반대 골문으로 진행합니다. 공을 걷어낸 뒤의 두 번째 공도 계속 플레이합니다.\n아웃은 킥인, 골라인 아웃은 해당 골키퍼의 재시작입니다. 이 축소 게임은 오프사이드를 적용하지 않습니다. 득점 뒤에는 실점 팀 골키퍼에게서 시작합니다.\n반칙은 피해 팀의 해당 지점 간접 프리킥으로 재개하며 상대는 3m 떨어집니다.\n\n각 세트 측면·중앙·뒤 지원의 역할을 한 자리씩 바꾸며 골키퍼는 유지합니다.","coaching":"박스 안 모두 같은 곳으로 달린다 → 가까운 공간·먼 공간·뒤에서 도착할 공간을 나눠 보고 동시에 출발할 필요가 있는지 묻습니다.\n\n마지막 패스 뒤 수비 준비가 사라진다 → 공 밖의 한 선수만 관찰해 상대의 첫 출구를 누가 준비했는지 확인합니다.","func":"관찰: 패스 경로·수신 공간·도착 시점·후방 대비를 득점 여부와 나누어 적습니다.\n\n전이: 크로스 횟수보다 실제 마무리 조건과 공을 잃었을 때의 첫 대응을 봅니다.","prog":"쉽게: 처음 두 번의 시작은 수비를 자기 골문 쪽 10m 구역에서 출발시켜 공격이 도착 관계를 읽게 합니다.\n\n어렵게: 마지막 세트는 골키퍼부터 자유롭게 시작해 측면에 도착하기 전 선택도 확인합니다.","minutes":3,"sets":4,"source":{"url":"https://weloveprocess.netlify.app/textbook/practice/d08/","scene":"d08"},"trainingArea":{"width":44,"height":40},"textbookItem":"scene-d08","textbookRevision":2,"animIdx":0}]}
