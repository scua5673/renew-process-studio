:"#607467","lw":1,"op":1,"pts":[{"x":518.25,"y":225.625},{"x":496.2,"y":323.8}]}],"equipment":[]},"cap":"조정 · 수신자의 내줄 길과 전방의 다른 높이를 연결합니다.","hold":2.5,"dur":1.3},{"snap":{"pitchSpec":"grid40","orientation":"h","area":"full","pitchView":"full","pvSide":"own","fieldMode":"standard","spFlip":false,"pitchN":1,"pitchTheme":"train","label":"num","lines":true,"gridType":"off","tokenScale":1.2,"teamColors":{"blue":"#234f83","red":"#b54c46","yellow":"#b38c35"},"gkColors":{"blue":"#234f83","red":"#b54c46"},"teamTxtC":{"blue":"#ffffff","red":"#ffffff","yellow":"#ffffff"},"chip3d":false,"tokV":2,"tokShape":"circle","players":[{"id":1,"num":"B1","team":"blue","pos":"","color":null,"x":334.5,"y":242.95},{"id":2,"num":"B2","team":"blue","pos":"","color":null,"x":393.3,"y":502.825},{"id":3,"num":"B3","team":"blue","pos":"","color":null,"x":613.8,"y":225.625},{"id":4,"num":"B4","team":"blue","pos":"","color":null,"x":687.3,"y":531.7},{"id":5,"num":"R1","team":"red","pos":"","color":null,"x":444.75,"y":225.625},{"id":6,"num":"R2","team":"red","pos":"","color":null,"x":518.25,"y":352.675},{"id":7,"num":"R3","team":"red","pos":"","color":null,"x":540.3,"y":525.925},{"id":8,"num":"R4","team":"red","pos":"","color":null,"x":760.8,"y":427.75},{"id":9,"num":"N1","team":"yellow","pos":"","color":null,"x":216.9,"y":370},{"id":10,"num":"N2","team":"yellow","pos":"","color":null,"x":893.1,"y":370}],"ball":{"x":351.5,"y":259.95,"scale":0.38},"drawings":[{"type":"rectline","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":187.5,"y":81.25},{"x":922.5,"y":658.75}]},{"type":"line","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":555,"y":81.25},{"x":555,"y":658.75}]},{"type":"dashline","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":246.3,"y":81.25},{"x":246.3,"y":658.75}]},{"type":"dashline","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":863.7,"y":81.25},{"x":863.7,"y":658.75}]},{"type":"pass","color":"#234f83","lw":1,"op":1,"pts":[{"x":334.5,"y":242.95},{"x":216.9,"y":370}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":518.25,"y":225.625},{"x":444.75,"y":225.625}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":613.8,"y":358.45},{"x":518.25,"y":352.675}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":466.8,"y":416.2},{"x":393.3,"y":502.825}]}],"equipment":[]},"cap":"다른 조건 · 전방이 닫히면 시작 중립에게 돌아가 새 각도를 만들 수 있습니다.","hold":2.5,"dur":1.3}],"overview":"선수·공·이동은 원리를 설명하기 위한 가상 배치입니다. 세 그림은 학습용 조건 비교이며 실제 경기의 좌표·거리·시간을 측정한 자료가 아닙니다. 구체적인 운영은 아래 훈련 카드를 따릅니다.\n\n목표: 앞으로 받을 선수와 내줄 지원을 다른 높이에 둔다.","setup":"중앙에서 파랑 4명과 빨강 4명, 양 끝에 중립 1명씩을 둡니다. 중립은 끝 구역 안에서 움직이며 소유 팀을 돕습니다.\n준비물: 공 5개, 조끼 세 색, 경계·끝 구역 콘. 끝 구역은 깊이 3m씩이며 전체 길이에 포함됩니다.","method":"시작: 파랑은 왼쪽, 빨강은 오른쪽 끝 중립에게 받아 시작합니다. 상대 끝 중립에게 연결하면 1점입니다.\n\n전방 연결이 막히면 시작 쪽 중립에게 돌아갈 수 있습니다. 중앙을 반드시 거쳐야 하는 패스 순서는 없습니다.\n상대 끝 중립이 받아 점수가 나면 양 팀의 공격 방향을 뒤집고 같은 팀이 반대 방향을 공격합니다. 상대는 즉시 대응합니다.\n아웃·반칙은 공을 내보내거나 반칙한 팀의 상대가 자기 시작 쪽 중립에게서 다시 시작합니다.\n\n세트마다 각 팀 한 명이 중립 한 명과 교대합니다. 중립 경험과 중앙 수신 경험이 한 선수에게만 몰리지 않게 기록합니다.","coaching":"수신자와 지원이 같은 선에 선다 → 패스 직전 멈춰 앞을 볼 선수와 내줄 선수가 겹쳤는지 묻습니다. 위치를 바꾼 뒤 수비가 다른 길도 막게 합니다.\n\n앞으로만 넣다가 반복해서 잃는다 → 돌려주는 패스를 허용한 상태에서 전진 가능한 수신과 어려운 수신을 비교합니다.","func":"관찰: 전방 연결 기회·선택·수신 뒤 유지 여부를 각각 적습니다. 통과 횟수만으로 판단하지 않습니다.\n\n전이: D03에서 골문과 전환이 있어도 같은 기준으로 연결하는지 봅니다.","prog":"쉽게: 중앙 폭을 26m로 넓혀 다른 각도를 찾을 시간을 줍니다.\n\n어렵게: 끝 중립이 받은 뒤 첫 연결까지 상대가 압박할 수 있게 하되 끝 구역 충돌을 피할 공간을 확보합니다.","minutes":3,"sets":4,"source":{"url":"https://weloveprocess.netlify.app/textbook/practice/d02/","scene":"d02"},"trainingArea":{"width":28,"height":22},"textbookItem":"scene-d02","textbookRevision":1,"animIdx":0}]}
