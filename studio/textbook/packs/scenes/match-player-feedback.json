0,"color":null}],"ball":{"x":240,"y":370,"scale":0.38},"drawings":[{"type":"pass","color":"#b48018","lw":1,"op":1,"pts":[{"x":240,"y":370},{"x":440,"y":330}]}],"equipment":[]},"dur":1.3,"hold":2.5,"cap":"상황 공유 · 로드리 역할의 선수가 밀착 수비를 받는 관계를 먼저 표시합니다."},{"snap":{"pitchSpec":"fifa","orientation":"h","area":"full","pitchView":"full","pvSide":"own","fieldMode":"standard","spFlip":false,"pitchN":1,"pitchTheme":"train","label":"num","lines":true,"gridType":"off","tokenScale":1.5,"tokV":2,"tokShape":"circle","players":[{"id":1,"team":"blue","num":"A","pos":"","x":424,"y":346,"color":null},{"id":2,"team":"blue","num":"B","pos":"","x":240,"y":370,"color":null},{"id":3,"team":"blue","num":"C","pos":"","x":500,"y":530,"color":null},{"id":4,"team":"blue","num":"D","pos":"","x":520,"y":170,"color":null},{"id":5,"team":"blue","num":"E","pos":"","x":690,"y":540,"color":null},{"id":6,"team":"red","num":"X","pos":"","x":465,"y":315,"color":null},{"id":7,"team":"red","num":"Y","pos":"","x":640,"y":210,"color":null},{"id":8,"team":"red","num":"Z","pos":"","x":800,"y":390,"color":null}],"ball":{"x":440,"y":330,"scale":0.38},"drawings":[{"type":"pass","color":"#b48018","lw":1,"op":1,"pts":[{"x":440,"y":330},{"x":500,"y":530}]},{"type":"run","color":"#66869d","lw":1,"op":0.8,"pts":[{"x":424,"y":346},{"x":480,"y":360}]}],"equipment":[]},"dur":1.3,"hold":2.5,"cap":"선수의 시선 · 공을 받기 전에 볼 수 있는 두 출구를 비교합니다."},{"snap":{"pitchSpec":"fifa","orientation":"h","area":"full","pitchView":"full","pvSide":"own","fieldMode":"standard","spFlip":false,"pitchN":1,"pitchTheme":"train","label":"num","lines":true,"gridType":"off","tokenScale":1.5,"tokV":2,"tokShape":"circle","players":[{"id":1,"team":"blue","num":"A","pos":"","x":480,"y":360,"color":null},{"id":2,"team":"blue","num":"B","pos":"","x":240,"y":370,"color":null},{"id":3,"team":"blue","num":"C","pos":"","x":484,"y":546,"color":null},{"id":4,"team":"blue","num":"D","pos":"","x":520,"y":170,"color":null},{"id":5,"team":"blue","num":"E","pos":"","x":690,"y":540,"color":null},{"id":6,"team":"red","num":"X","pos":"","x":480,"y":330,"color":null},{"id":7,"team":"red","num":"Y","pos":"","x":620,"y":210,"color":null},{"id":8,"team":"red","num":"Z","pos":"","x":800,"y":390,"color":null}],"ball":{"x":500,"y":530,"scale":0.38},"drawings":[{"type":"pass","color":"#b48018","lw":1,"op":1,"pts":[{"x":500,"y":530},{"x":690,"y":540}]},{"type":"run","color":"#66869d","lw":1,"op":0.8,"pts":[{"x":480,"y":360},{"x":520,"y":370}]}],"equipment":[]},"dur":1.3,"hold":2.5,"cap":"다음 행동 · 상대가 따라오는 쪽과 다른 자유 선수를 찾습니다."},{"snap":{"pitchSpec":"fifa","orientation":"h","area":"full","pitchView":"full","pvSide":"own","fieldMode":"standard","spFlip":false,"pitchN":1,"pitchTheme":"train","label":"num","lines":true,"gridType":"off","tokenScale":1.5,"tokV":2,"tokShape":"circle","players":[{"id":1,"team":"blue","num":"A","pos":"","x":520,"y":370,"color":null},{"id":2,"team":"blue","num":"B","pos":"","x":240,"y":370,"color":null},{"id":3,"team":"blue","num":"C","pos":"","x":500,"y":530,"color":null},{"id":4,"team":"blue","num":"D","pos":"","x":520,"y":170,"color":null},{"id":5,"team":"blue","num":"E","pos":"","x":674,"y":556,"color":null},{"id":6,"team":"red","num":"X","pos":"","x":530,"y":340,"color":null},{"id":7,"team":"red","num":"Y","pos":"","x":600,"y":210,"color":null},{"id":8,"team":"red","num":"Z","pos":"","x":800,"y":390,"color":null}],"ball":{"x":690,"y":540,"scale":0.38},"drawings":[],"equipment":[]},"dur":1.3,"hold":2.5,"cap":"검토 · 득점 여부보다 합의한 정보 확인이 다음 시도에서 나타났는지 봅니다."}],"animIdx":0,"folder":"교과서 · 실제 경기 학습","tags":["교과서","경기 사례","학습 도식"],"overview":"공식 경기 분석을 바탕으로 PROCESS가 만든 학습용 관계 도식입니다. 필요한 선수만 표시했으며 문자 표시는 등번호가 아닙니다. 위치·거리·이동 시간과 패스 경로는 실측 재현이 아닙니다. 마지막 단계의 검토와 조건 비교는 학습 질문입니다.","method":"과르디올라는 UEFA에 실린 경기 후 발언에서 전반에 중원의 자유 선수를 읽는 데 어려움이 있었고, 하프타임에 로드리에게 서두르지 말고 자유 선수를 찾도록 말했다고 설명했습니다. 원문은 진정과 관찰할 정보에 초점을 둔 메시지였습니다.\n\n인터는 중원에서 로드리에게 밀착하며 연결을 어렵게 했습니다. 로드리가 후반 결승골을 넣었다는 사실과 감독의 피드백이 그 골을 직접 만들었다는 인과 주장은 구분해야 합니다.\n\n학습 단계\n1. 상황 공유 · 로드리 역할의 선수가 밀착 수비를 받는 관계를 먼저 표시합니다.\n2. 선수의 시선 · 공을 받기 전에 볼 수 있는 두 출구를 비교합니다.\n3. 다음 행동 · 상대가 따라오는 쪽과 다른 자유 선수를 찾습니다.\n4. 검토 · 득점 여부보다 합의한 정보 확인이 다음 시도에서 나타났는지 봅니다.","coaching":"PROCESS 비교 실습\n선수가 수신 전에 출구를 못 봤다 → 패스 직전 화면을 멈추고 선택지를 설명하게 한다 → 코치의 답을 따라 말하지 않고 자신의 시야를 설명하는가\n\n출구는 알았지만 실행이 늦었다 → 상대의 출발 거리와 패스 속도를 조정해 다시 시도한다 → 정보 이해와 기술 실행을 별도로 확인하는가\n\n한 장면을 결과 직전에서 멈추고 선수의 의도를 먼저 듣습니다. 다음 시도에서는 자유 선수 확인처럼 한 가지 단서만 합의합니다. Studio IDP나 미팅 기록에 선수의 말·코치의 질문·합의한 단서·후속 관찰을 나누어 남기고, 코치의 해석을 선수의 발언처럼 적지 않습니다.","source":{"url":"https://www.uefa.com/uefachampionsleague/news/0282-183fa8a707c0-4056c043e3d1-1000--in-the-zone-city-s-win-analysed/","fixture":"맨체스터 시티 1–0 인터","date":"2023-06-10","locator":"Coach and player assessments · Guardiola의 하프타임 설명","article":"https://weloveprocess.netlify.app/focus/player-feedback/","scene":"match-player-feedback"},"textbookItem":"scene-match-player-feedback","textbookRevision":1}]}
