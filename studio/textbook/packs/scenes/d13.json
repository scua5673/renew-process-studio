y":696.6666666666666}]},{"type":"line","color":"#aa852f","lw":1,"op":1,"pts":[{"x":174.20000000000002,"y":343.8666666666667},{"x":189.13333333333335,"y":343.8666666666667}]},{"type":"line","color":"#aa852f","lw":1,"op":1,"pts":[{"x":174.20000000000002,"y":396.1333333333333},{"x":189.13333333333335,"y":396.1333333333333}]},{"type":"line","color":"#aa852f","lw":1,"op":1,"pts":[{"x":920.8666666666668,"y":343.8666666666667},{"x":935.8,"y":343.8666666666667}]},{"type":"line","color":"#aa852f","lw":1,"op":1,"pts":[{"x":920.8666666666668,"y":396.1333333333333},{"x":935.8,"y":396.1333333333333}]},{"type":"pass","color":"#234f83","lw":1,"op":1,"pts":[{"x":286.2,"y":370},{"x":443,"y":200.13333333333335}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":465.40000000000003,"y":272},{"x":435.5333333333333,"y":304.66666666666663}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":480.3333333333333,"y":533.3333333333333},{"x":383.26666666666665,"y":435.3333333333333}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":622.2,"y":370},{"x":443,"y":200.13333333333335}]}],"equipment":[]},"cap":"압박이 풀린 조건 · 공만 따라가기보다 중앙으로 다시 연결할 길을 줄입니다.","hold":2.5,"dur":1.3}],"overview":"선수·공·이동은 원리를 설명하기 위한 가상 배치입니다. 세 그림은 학습용 조건 비교이며 실제 경기의 좌표·거리·시간을 측정한 자료가 아닙니다. 구체적인 운영은 아래 훈련 카드를 따릅니다.\n\n목표: 가까운 선수의 접근과 그 뒤 출구 차단을 소유 변화에 맞춰 바꾼다.","setup":"파랑 4·빨강 4·중립 3명이 모두 안에서 활동합니다. 중립은 소유가 바뀌면 새 소유 팀을 돕습니다.\n준비물: 공 5개, 중립 조끼 3장, 양 끝 운반 출구 게이트 각 1개.","method":"시작: 코치가 한 팀에게 넣습니다. 일반 소유 중에는 6회 연속 패스하면 1점입니다.\n\n공을 되찾은 팀은 첫 세 번의 패스 안에 어느 끝 게이트로든 통제하며 나가면 1점입니다. 출구가 막혔으면 소유를 유지할 수 있습니다.\n중립의 패스도 횟수에 포함합니다. 압박 팀은 무조건 탈취할 의무 없이 출구를 가릴 수 있습니다.\n아웃·출구 득점은 상대에게 코치가 새 공을 줍니다. 패스 득점은 계속 진행하고 횟수만 다시 셉니다.\n\n세트마다 중립을 바꾸고 마지막 세트는 출구 보너스의 패스 제한을 없앱니다.","coaching":"공을 잃자 모두 공으로 몰린다 → 첫 접근 1명과 출구를 볼 동료를 구분합니다. 상대가 반대 게이트를 써도 대응하게 합니다.\n\n중립을 자기 편으로 착각한다 → 소유가 바뀐 순간 중립의 역할 전환을 확인하고 같은 장면을 다시 시작합니다.","func":"관찰: 상실 직전 주변 배치와 상실 후 첫 접근·중앙 출구·반대 출구를 이어 기록합니다.\n\n전이: 게이트와 패스 보너스 없는 경기에서 지연이나 복귀가 더 나은 조건도 비교합니다.","prog":"쉽게: 처음에는 중립 한 명을 중앙 뒤 지원에 두어 소유 후 첫 연결을 쉽게 합니다.\n\n어렵게: 한 중립을 빼 4v4+2로 진행합니다. 빠진 선수는 한 세트의 출구 선택을 기록하고 다음에 교대합니다.","minutes":3,"sets":4,"source":{"url":"https://weloveprocess.netlify.app/textbook/practice/d13/","scene":"d13"},"trainingArea":{"width":32,"height":28},"textbookItem":"scene-d13","textbookRevision":1,"animIdx":0}]}
