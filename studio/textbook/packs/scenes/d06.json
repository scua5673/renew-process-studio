"#234f83","red":"#b54c46","yellow":"#b38c35"},"gkColors":{"blue":"#234f83","red":"#b54c46"},"teamTxtC":{"blue":"#ffffff","red":"#ffffff","yellow":"#ffffff"},"chip3d":false,"tokV":2,"tokShape":"circle","players":[{"id":1,"num":"B1","team":"blue","pos":"","color":null,"x":303,"y":272},{"id":2,"num":"B2","team":"blue","pos":"","color":null,"x":496.2,"y":513.7333333333333},{"id":3,"num":"B3","team":"blue","pos":"","color":null,"x":639,"y":337.3333333333333},{"id":4,"num":"B4","team":"blue","pos":"","color":null,"x":807,"y":383.06666666666666},{"id":5,"num":"R1","team":"red","pos":"","color":null,"x":504.6,"y":174},{"id":6,"num":"R2","team":"red","pos":"","color":null,"x":555,"y":402.66666666666663},{"id":7,"num":"R3","team":"red","pos":"","color":null,"x":706.2,"y":291.6},{"id":8,"num":"R4","team":"red","pos":"","color":null,"x":723,"y":565.9999999999999},{"id":9,"num":"N1","team":"yellow","pos":"","color":null,"x":496.2,"y":356.93333333333334},{"id":10,"num":"N2","team":"yellow","pos":"","color":null,"x":521.4,"y":10.666666666666714},{"id":11,"num":"N3","team":"yellow","pos":"","color":null,"x":681,"y":729.3333333333333}],"ball":{"x":513.2,"y":530.7333333333333,"scale":0.38},"drawings":[{"type":"rectline","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":135,"y":43.33333333333337},{"x":975,"y":696.6666666666666}]},{"type":"line","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":555,"y":43.33333333333337},{"x":555,"y":696.6666666666666}]},{"type":"dashline","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":135,"y":160.93333333333334},{"x":975,"y":160.93333333333334}]},{"type":"dashline","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":135,"y":579.0666666666666},{"x":975,"y":579.0666666666666}]},{"type":"dashline","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":181.66666666666666,"y":43.33333333333337},{"x":181.66666666666666,"y":696.6666666666666}]},{"type":"dashline","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":928.3333333333333,"y":43.33333333333337},{"x":928.3333333333333,"y":696.6666666666666}]},{"type":"pass","color":"#234f83","lw":1,"op":1,"pts":[{"x":496.2,"y":513.7333333333333},{"x":681,"y":729.3333333333333}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":429,"y":533.3333333333333},{"x":496.2,"y":513.7333333333333}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":765,"y":552.9333333333333},{"x":807,"y":383.06666666666666}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":790.2,"y":487.6},{"x":723,"y":565.9999999999999}]}],"equipment":[]},"cap":"다른 조건 · 같은 교환을 반복하지 않고 아래쪽의 공간과 지원을 사용할 수 있습니다.","hold":2.5,"dur":1.3}],"overview":"선수·공·이동은 원리를 설명하기 위한 가상 배치입니다. 세 그림은 학습용 조건 비교이며 실제 경기의 좌표·거리·시간을 측정한 자료가 아닙니다. 구체적인 운영은 아래 훈련 카드를 따릅니다.\n\n목표: 동료가 비운 기능을 채우며 같은 통로의 중복을 줄인다.","setup":"중앙 파랑 4·빨강 4·중립 1명, 양 터치라인 바깥 중립 1명씩으로 총 11명. 측면 중립은 자기 선을 따라 움직입니다.\n준비물: 공 5개, 조끼 세 색, 양 끝 득점선과 측면 통로 콘.","method":"시작: 중앙 중립이 한 팀에게 패스합니다. 양 팀은 서로 반대쪽 끝 선을 공격합니다.\n\n끝 선을 공과 함께 운반해 넘거나, 전체 길이에 포함한 끝 2m 구역에서 동료가 패스를 통제하면 1점입니다.\n측면 중립은 소유 팀을 지원하고 밖에서만 활동합니다. 안쪽 선수의 위치 교환은 자유입니다.\n탈취하면 반대 방향을 공격합니다. 득점 뒤 상대가 자기 끝 선에서 시작하며 수비는 중앙선 뒤로 돌아갑니다. 아웃·반칙은 상대가 그 지점에서 킥인하며 수비는 3m 물러납니다.\n\n매 세트 중앙 중립과 두 측면 중립을 바꿉니다. 같은 선수에게 바깥 역할만 주지 않습니다.","coaching":"두 선수가 동시에 바깥으로 나온다 → 폭을 맡은 선수를 확인하고 다른 한 명이 안쪽 연결 또는 깊이를 준비하게 합니다.\n\n교환 동작만 외운다 → 수비가 따라오지 않을 때도 교환해야 하는지 묻고 그대로 받는 선택을 남깁니다.","func":"관찰: 교환 전후 폭·안쪽 연결·깊이 중 어떤 기능이 남거나 사라졌는지 적습니다.\n\n전이: 포지션의 이름보다 실제 경기에서 서로 다른 기능이 유지되는지 확인합니다.","prog":"쉽게: 측면 중립을 수비가 가로막지 못하게 해 첫 연결을 쉽게 만듭니다.\n\n어렵게: 측면 중립의 이동 범위를 자기 절반으로 줄여 안쪽 선수의 지원을 더 요구합니다.","minutes":3,"sets":4,"source":{"url":"https://weloveprocess.netlify.app/textbook/practice/d06/","scene":"d06"},"trainingArea":{"width":36,"height":28},"textbookItem":"scene-d06","textbookRevision":1,"animIdx":0}]}
