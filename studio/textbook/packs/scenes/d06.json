y":579.9999999999999}]},{"type":"pass","color":"#234f83","lw":1,"op":1,"pts":[{"x":496.2,"y":513.7333333333333},{"x":681,"y":729.3333333333333}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":429,"y":533.3333333333333},{"x":496.2,"y":513.7333333333333}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":765,"y":552.9333333333333},{"x":807,"y":383.06666666666666}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":790.2,"y":487.6},{"x":723,"y":565.9999999999999}]}],"equipment":[]},"cap":"다른 조건 · 같은 교환을 반복하지 않고 아래쪽의 공간과 지원을 사용할 수 있습니다.","hold":2.5,"dur":1.3}],"overview":"선수·공·이동은 원리를 설명하기 위한 가상 배치입니다. 세 그림은 학습용 조건 비교이며 실제 경기의 좌표·거리·시간을 측정한 자료가 아닙니다. 각 그림의 흰 공은 첫 실선 패스의 출발점이고, 실선은 가능한 패스 연결, 점선은 기본 배치에서 바뀐 선수 위치를 뜻합니다. 세 그림을 끊김 없는 연속 장면으로 읽지 않습니다. 구체적인 운영은 연결된 공통 훈련 카드를 따릅니다.\n\n목표: 동료가 비운 기능을 채우며 같은 통로의 중복을 줄인다.","setup":"중앙 파랑 4·빨강 4·중립 1명, 양 터치라인 바깥 중립 1명씩으로 총 11명. 측면 중립은 자기 선을 따라 움직입니다. 측면 참고 통로는 폭 5m입니다. 측면 중립은 양 팀 공통 지원이며 수비는 경기장 안에서 연결 경로를 차단합니다.\n준비물: 공 5개, 조끼 세 색, 양 끝 득점선과 측면 통로 콘.","method":"시작: 첫 세트는 중앙 중립 N1이 파랑에게, 다음 세트는 빨강에게 첫 공을 줍니다. 파랑은 오른쪽, 빨강은 왼쪽 끝 선을 공격합니다.\n\n필드 선수가 끝 선을 공과 함께 운반해 넘거나, 전체 길이에 포함한 끝 2m 구역에서 같은 팀 필드 선수가 패스를 통제하면 1점입니다. 중립의 수신 자체에는 점수를 주지 않습니다.\n측면 중립은 소유 팀을 지원하고 밖에서만 활동합니다. 안쪽 선수의 위치 교환은 자유입니다.\n탈취하면 반대 방향을 공격합니다. 득점 뒤 상대가 자기 끝 선에서 시작하며 수비는 중앙선 뒤로 돌아갑니다. 아웃은 상대가 그 지점에서 킥인하며 수비는 3m 물러납니다.\n이 축소 게임은 오프사이드를 적용하지 않습니다. 실제 경기의 최종 수비선과 출발 시점은 별도로 확인합니다.\n반칙은 피해 팀의 해당 지점 간접 프리킥으로 재개하며 상대는 3m 떨어집니다.\n\n매 세트 중앙 중립과 두 측면 중립을 바꿉니다. 같은 선수에게 바깥 역할만 주지 않습니다.","coaching":"두 선수가 동시에 바깥으로 나온다 → 폭을 맡은 선수를 확인하고 다른 한 명이 안쪽 연결 또는 깊이를 준비하게 합니다.\n\n교환 동작만 외운다 → 수비가 따라오지 않을 때도 교환해야 하는지 묻고 그대로 받는 선택을 남깁니다.","func":"관찰: 교환 전후 폭·안쪽 연결·깊이 중 어떤 기능이 남거나 사라졌는지 적습니다.\n\n전이: 포지션의 이름보다 실제 경기에서 서로 다른 기능이 유지되는지 확인합니다.","prog":"쉽게: 전체 폭을 32m로 넓히고 측면 중립과 안쪽 선수의 규칙은 유지합니다. 연결 각도와 수비 이동 거리의 변화를 함께 봅니다.\n\n어렵게: 지원 범위 변형: N2는 그림의 왼쪽 절반, N3는 오른쪽 절반의 터치라인만 사용합니다. 중립은 소유 팀이 바뀌어도 이 구간을 유지하며 다음 세트에 구간을 교환합니다.","minutes":3,"sets":4,"source":{"url":"https://weloveprocess.netlify.app/textbook/practice/d06/","scene":"d06"},"trainingArea":{"width":36,"height":28},"textbookItem":"scene-d06","textbookRevision":2,"animIdx":0}]}
