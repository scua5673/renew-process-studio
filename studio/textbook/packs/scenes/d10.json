4","team":"red","pos":"","color":null,"x":706.8,"y":235},{"id":11,"num":"R5","team":"red","pos":"","color":null,"x":726.6,"y":413.2},{"id":12,"num":"R6","team":"red","pos":"","color":null,"x":640.8,"y":542.8},{"id":13,"num":"N1","team":"yellow","pos":"","color":null,"x":251.4,"y":370},{"id":14,"num":"N2","team":"yellow","pos":"","color":null,"x":858.6,"y":370}],"ball":{"x":512.6,"y":559.8,"scale":0.38},"drawings":[{"type":"rectline","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":225,"y":100},{"x":885,"y":640}]},{"type":"line","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":555,"y":100},{"x":555,"y":640}]},{"type":"dashline","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":277.8,"y":100},{"x":277.8,"y":640}]},{"type":"dashline","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":832.2,"y":100},{"x":832.2,"y":640}]},{"type":"pass","color":"#234f83","lw":1,"op":1,"pts":[{"x":495.6,"y":542.8},{"x":667.2,"y":370}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":574.8,"y":370},{"x":594.6,"y":424}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":561.6,"y":532},{"x":555,"y":515.8}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":720,"y":380.8},{"x":726.6,"y":413.2}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":706.8,"y":521.2},{"x":640.8,"y":542.8}]}],"equipment":[]},"cap":"반대편 이동 · 공이 아래로 옮겨 가면 역할을 새로 나누고 먼 쪽을 유지합니다.","hold":2.5,"dur":1.3}],"overview":"선수·공·이동은 원리를 설명하기 위한 가상 배치입니다. 세 그림은 학습용 조건 비교이며 실제 경기의 좌표·거리·시간을 측정한 자료가 아닙니다. 구체적인 운영은 아래 훈련 카드를 따릅니다.\n\n목표: 공에 나가는 선수 뒤의 중앙을 메우며 반대편 위험을 준비한다.","setup":"끝 중립 1명씩, 중앙 각 팀 6명입니다. 비소유 팀은 두 줄을 만들어 시작하되 진행 중 줄의 인원은 자유롭게 바뀝니다.\n준비물: 공 6개, 조끼 세 색, 길이를 세 구간으로 나누는 참고 콘.","method":"시작: 한쪽 끝 중립에서 시작해 반대 끝 중립에게 연결하면 1점입니다. 수비는 시작 높이를 스스로 선택합니다.\n\n공격 팀은 중앙·측면·직접 연결을 자유롭게 선택합니다. 수비는 중앙 구역에 머물 의무가 없습니다.\n탈취하면 반대쪽 중립을 목표로 전진합니다. 압박이 풀렸다고 플레이를 끊지 않습니다.\n득점하면 양 팀의 공격 방향을 뒤집고 같은 팀이 이어갑니다. 아웃은 공을 내보내지 않은 팀의 시작 중립에게 줍니다.\n\n매 세트 중립을 교대하고 각 팀에서 앞줄·뒷줄 역할 두 명을 교환합니다.","coaching":"공이 옆으로 갈 때 중앙이 빈다 → 첫 압박·그 뒤 커버·먼 쪽 균형을 세 선수에게 나누어 설명하게 합니다.\n\n후방 패스마다 모두 쫓아간다 → 상대의 실수 신호와 우리 팀의 준비가 함께 갖춰졌는지 묻습니다.","func":"관찰: 압박에 나간 직후 중앙 수신을 허용했는지, 공이 이동할 때 반대편이 준비됐는지 기록합니다.\n\n전이: 실제 상대의 긴 패스와 골문 위협까지 포함해 블록 높이를 다시 판단합니다.","prog":"쉽게: 공격 팀은 공을 받는 첫 중립의 연결까지 기다리게 해 수비가 시작 배치를 정리할 시간을 줍니다.\n\n어렵게: 시작 중립이 어느 선수에게나 직접 연결하게 해 두 줄을 한 번에 넘는 패스도 대비합니다.","minutes":4,"sets":3,"source":{"url":"https://weloveprocess.netlify.app/textbook/practice/d10/","scene":"d10"},"trainingArea":{"width":44,"height":36},"textbookItem":"scene-d10","textbookRevision":1,"animIdx":0}]}
