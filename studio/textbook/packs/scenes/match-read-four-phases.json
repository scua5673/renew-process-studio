or":null},{"id":6,"team":"red","num":"Y","pos":"","x":690,"y":340,"color":null},{"id":7,"team":"red","num":"Z","pos":"","x":400,"y":300,"color":null}],"ball":{"x":310,"y":250,"scale":0.38},"drawings":[{"type":"dribble","color":"#b48018","lw":1,"op":1,"pts":[{"x":310,"y":250},{"x":480,"y":230}]},{"type":"run","color":"#66869d","lw":1,"op":0.8,"pts":[{"x":570,"y":130},{"x":610,"y":130}]},{"type":"run","color":"#66869d","lw":1,"op":0.8,"pts":[{"x":320,"y":400},{"x":387,"y":390}]},{"type":"run","color":"#66869d","lw":1,"op":0.8,"pts":[{"x":230,"y":470},{"x":283,"y":457}]}],"equipment":[]},"dur":1.3,"hold":2.5,"cap":"수비 중 · 음바페 역할의 출구는 높고 넓게 남습니다. 나머지 수비 관계도 함께 봅니다."},{"snap":{"pitchSpec":"fifa","orientation":"h","area":"full","pitchView":"full","pvSide":"own","fieldMode":"standard","spFlip":false,"pitchN":1,"pitchTheme":"train","label":"num","lines":true,"gridType":"off","tokenScale":1.5,"tokV":2,"tokShape":"circle","players":[{"id":1,"team":"blue","num":"A","pos":"","x":464,"y":246,"color":null},{"id":2,"team":"blue","num":"B","pos":"","x":610,"y":130,"color":null},{"id":3,"team":"blue","num":"C","pos":"","x":387,"y":390,"color":null},{"id":4,"team":"blue","num":"D","pos":"","x":283,"y":457,"color":null},{"id":5,"team":"red","num":"X","pos":"","x":680,"y":173,"color":null},{"id":6,"team":"red","num":"Y","pos":"","x":753,"y":327,"color":null},{"id":7,"team":"red","num":"Z","pos":"","x":490,"y":293,"color":null}],"ball":{"x":480,"y":230,"scale":0.38},"drawings":[{"type":"pass","color":"#b48018","lw":1,"op":1,"pts":[{"x":480,"y":230},{"x":690,"y":130}]},{"type":"run","color":"#66869d","lw":1,"op":0.8,"pts":[{"x":464,"y":246},{"x":590,"y":250}]},{"type":"run","color":"#66869d","lw":1,"op":0.8,"pts":[{"x":610,"y":130},{"x":674,"y":146}]},{"type":"run","color":"#66869d","lw":1,"op":0.8,"pts":[{"x":387,"y":390},{"x":453,"y":380}]},{"type":"run","color":"#66869d","lw":1,"op":0.8,"pts":[{"x":283,"y":457},{"x":337,"y":443}]}],"equipment":[]},"dur":1.3,"hold":2.5,"cap":"탈환 · 덴마크의 후방 선수가 출구를 의식할 때 에르난데스 역할의 운반 공간을 찾습니다."},{"snap":{"pitchSpec":"fifa","orientation":"h","area":"full","pitchView":"full","pvSide":"own","fieldMode":"standard","spFlip":false,"pitchN":1,"pitchTheme":"train","label":"num","lines":true,"gridType":"off","tokenScale":1.5,"tokV":2,"tokShape":"circle","players":[{"id":1,"team":"blue","num":"A","pos":"","x":590,"y":250,"color":null},{"id":2,"team":"blue","num":"B","pos":"","x":674,"y":146,"color":null},{"id":3,"team":"blue","num":"C","pos":"","x":453,"y":380,"color":null},{"id":4,"team":"blue","num":"D","pos":"","x":337,"y":443,"color":null},{"id":5,"team":"red","num":"X","pos":"","x":740,"y":177,"color":null},{"id":6,"team":"red","num":"Y","pos":"","x":817,"y":313,"color":null},{"id":7,"team":"red","num":"Z","pos":"","x":580,"y":287,"color":null}],"ball":{"x":690,"y":130,"scale":0.38},"drawings":[{"type":"pass","color":"#b48018","lw":1,"op":1,"pts":[{"x":690,"y":130},{"x":820,"y":240}]},{"type":"run","color":"#66869d","lw":1,"op":0.8,"pts":[{"x":590,"y":250},{"x":804,"y":256}]},{"type":"run","color":"#66869d","lw":1,"op":0.8,"pts":[{"x":674,"y":146},{"x":790,"y":150}]},{"type":"run","color":"#66869d","lw":1,"op":0.8,"pts":[{"x":453,"y":380},{"x":520,"y":370}]},{"type":"run","color":"#66869d","lw":1,"op":0.8,"pts":[{"x":337,"y":443},{"x":390,"y":430}]}],"equipment":[]},"dur":1.3,"hold":2.5,"cap":"공격 · 운반 뒤 측면으로 연결하고 안쪽 지원이 뒤따르는 관계를 읽습니다."},{"snap":{"pitchSpec":"fifa","orientation":"h","area":"full","pitchView":"full","pvSide":"own","fieldMode":"standard","spFlip":false,"pitchN":1,"pitchTheme":"train","label":"num","lines":true,"gridType":"off","tokenScale":1.5,"tokV":2,"tokShape":"circle","players":[{"id":1,"team":"blue","num":"A","pos":"","x":804,"y":256,"color":null},{"id":2,"team":"blue","num":"B","pos":"","x":790,"y":150,"color":null},{"id":3,"team":"blue","num":"C","pos":"","x":520,"y":370,"color":null},{"id":4,"team":"blue","num":"D","pos":"","x":390,"y":430,"color":null},{"id":5,"team":"red","num":"X","pos":"","x":800,"y":180,"color":null},{"id":6,"team":"red","num":"Y","pos":"","x":880,"y":300,"color":null},{"id":7,"team":"red","num":"Z","pos":"","x":670,"y":280,"color":null}],"ball":{"x":820,"y":240,"scale":0.38},"drawings":[],"equipment":[]},"dur":1.3,"hold":2.5,"cap":"다음 전환 · 공격을 전개한 뒤 공 뒤에 남는 지원까지 별도 관찰 지점으로 표시합니다."}],"animIdx":0,"folder":"교과서 · 실제 경기 학습","tags":["교과서","경기 사례","학습 도식"],"overview":"공식 경기 분석을 바탕으로 PROCESS가 만든 학습용 관계 도식입니다. 필요한 선수만 표시했으며 문자 표시는 등번호가 아닙니다. 위치·거리·이동 시간과 패스 경로는 실측 재현이 아닙니다. 마지막 단계의 검토와 조건 비교는 학습 질문입니다.","method":"FIFA의 덴마크전 분석은 프랑스가 깊이 수비하는 동안에도 음바페가 높고 넓은 위치를 유지한 장면을 보여 줍니다. 탈환 뒤 테오 에르난데스가 공을 운반하고, 측면의 음바페에게 연결한 다음 안쪽으로 지원해 득점으로 이어지는 조합을 만들었습니다.\n\n음바페의 위치는 상대의 수비 대비에도 영향을 주었습니다. FIFA는 덴마크 수비가 그의 위협을 의식하는 사이 에르난데스가 운반할 공간이 생긴 관계를 설명합니다. 이 장면이 프랑스의 모든 수비 상황에서 같은 선택을 정당화하지는 않습니다.\n\n학습 단계\n1. 수비 중 · 음바페 역할의 출구는 높고 넓게 남습니다. 나머지 수비 관계도 함께 봅니다.\n2. 탈환 · 덴마크의 후방 선수가 출구를 의식할 때 에르난데스 역할의 운반 공간을 찾습니다.\n3. 공격 · 운반 뒤 측면으로 연결하고 안쪽 지원이 뒤따르는 관계를 읽습니다.\n4. 다음 전환 · 공격을 전개한 뒤 공 뒤에 남는 지원까지 별도 관찰 지점으로 표시합니다.","coaching":"PROCESS 비교 실습\n출구 선수를 상대 두 명이 관리한다 → 탈환자의 중앙 운반 공간을 더 열어 준다 → 패스하지 않아도 출구의 위치가 도움을 주는가\n\n측면 수비가 버티지 못한다 → 출구 선수를 한 줄 내려 수비에 참여시킨다 → 탈환 위치와 첫 전진 거리의 변화가 감수할 만한가\n\n한 팀에 높은 출구 한 명을 둘 수 있는 7v7 게임을 구성합니다. 첫 라운드는 출구를 고정하고 다음 라운드는 수비 상황에 따라 내려올 수 있게 합니다. 득점 외에 수비에서 허용한 전진, 탈환 뒤 첫 선택, 공격이 끊긴 뒤의 지원을 같은 장면 카드에 적어 네 국면의 손익을 비교합니다.","source":{"url":"https://www.fifatrainingcentre.com/en/game/game-analysis/world-class-tactics/france-rest-attack-enhances-counter-attacking-efficiency.php","fixture":"프랑스 2–1 덴마크","date":"2022-11-26","locator":"Example 2 · Counter-attacking threat from any defensive phase","article":"https://weloveprocess.netlify.app/focus/read-four-phases/","scene":"match-read-four-phases"},"textbookItem":"scene-match-read-four-phases","textbookRevision":1}]}
