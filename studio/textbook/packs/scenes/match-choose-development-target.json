7,"y":277,"color":null},{"id":4,"team":"red","num":"X","pos":"","x":877,"y":387,"color":null},{"id":5,"team":"red","num":"Y","pos":"","x":870,"y":280,"color":null},{"id":6,"team":"red","num":"Z","pos":"","x":540,"y":420,"color":null}],"ball":{"x":840,"y":410,"scale":0.38},"drawings":[{"type":"shot","color":"#b48018","lw":1,"op":1,"pts":[{"x":840,"y":410},{"x":1025,"y":340}]},{"type":"run","color":"#66869d","lw":1,"op":0.8,"pts":[{"x":824,"y":426},{"x":940,"y":365}]},{"type":"run","color":"#66869d","lw":1,"op":0.8,"pts":[{"x":773,"y":567},{"x":800,"y":560}]},{"type":"run","color":"#66869d","lw":1,"op":0.8,"pts":[{"x":667,"y":277},{"x":700,"y":280}]}],"equipment":[]},"dur":1.3,"hold":2.5,"cap":"정보 · 크로스 전에 수비수와 공의 경로를 확인합니다."},{"snap":{"pitchSpec":"fifa","orientation":"h","area":"full","pitchView":"full","pvSide":"own","fieldMode":"standard","spFlip":false,"pitchN":1,"pitchTheme":"train","label":"num","lines":true,"gridType":"off","tokenScale":1.5,"tokV":2,"tokShape":"circle","players":[{"id":1,"team":"blue","num":"A","pos":"","x":940,"y":365,"color":null},{"id":2,"team":"blue","num":"B","pos":"","x":800,"y":560,"color":null},{"id":3,"team":"blue","num":"C","pos":"","x":700,"y":280,"color":null},{"id":4,"team":"red","num":"X","pos":"","x":900,"y":380,"color":null},{"id":5,"team":"red","num":"Y","pos":"","x":870,"y":280,"color":null},{"id":6,"team":"red","num":"Z","pos":"","x":540,"y":420,"color":null}],"ball":{"x":1025,"y":340,"scale":0.38},"drawings":[],"equipment":[]},"dur":1.3,"hold":2.5,"cap":"도착 · 먼저 도착할 길을 선택하고 실제 마무리 결과와 준비 행동을 구분합니다."}],"animIdx":0,"folder":"교과서 · 실제 경기 학습","tags":["교과서","경기 사례","학습 도식"],"overview":"공식 경기 분석을 바탕으로 PROCESS가 만든 학습용 관계 도식입니다. 필요한 선수만 표시했으며 문자 표시는 등번호가 아닙니다. 위치·거리·이동 시간과 패스 경로는 실측 재현이 아닙니다. 마지막 단계의 검토와 조건 비교는 학습 질문입니다.","method":"UEFA는 케인이 중원에서 공을 지킨 뒤 오른쪽 올리세에게 방향을 바꾸고, 다시 페널티 지역으로 들어가 크로스를 헤더로 마무리한 과정을 설명했습니다. 크로스를 기다리지 않고 무키엘레보다 먼저 공에 접근한 움직임이 강조됐습니다.\n\n이 장면은 준비·이동·마무리가 연결된 수행 사례입니다. 케인의 개인 개발 목표나 실제 훈련 내용을 공개한 자료는 아니며, 아래 목표 설정은 독자의 팀을 위한 별도 실습입니다.\n\n학습 단계\n1. 연결 · 케인 역할의 선수가 중원에서 공을 보호하고 측면을 찾습니다.\n2. 재출발 · 측면으로 보낸 뒤 패스에 머물지 않고 골문 쪽으로 다시 이동합니다.\n3. 정보 · 크로스 전에 수비수와 공의 경로를 확인합니다.\n4. 도착 · 먼저 도착할 길을 선택하고 실제 마무리 결과와 준비 행동을 구분합니다.","coaching":"PROCESS 비교 실습\n측면 연결 뒤 움직임이 멈춘다 → 마무리 기술보다 재출발 시점을 목표로 잡는다 → 공을 보낸 뒤 새로운 지원 행동을 하는가\n\n잘 움직이지만 수비와 겹친다 → 출발 전 수비 위치 확인을 한 가지 과제로 둔다 → 같은 속도로 달려도 더 다른 길을 선택하는가\n\n선수와 경기 장면 두세 개를 보고 현재 가장 자주 끊기는 행동을 함께 고릅니다. Studio IDP에는 목표 하나, 그 목표가 나타날 상황, 관찰 근거를 적습니다. 측면 패서가 있는 3v2 마무리에서 해당 상황을 만들되, 수비의 출발 위치를 바꿔 외운 달리기와 판단을 구분합니다.","source":{"url":"https://www.uefa.com/uefachampionsleague/news/0297-1d3667c30458-8ffba3538590-1000--in-the-zone-how-kane-s-all-round-game-unhinged-leverkusen/","fixture":"바이에른 뮌헨 3–0 레버쿠젠","date":"2025-03-05","locator":"Helping with the build-up / applying the killer touch · 9분 선제골","article":"https://weloveprocess.netlify.app/focus/choose-development-target/","scene":"match-choose-development-target"},"textbookItem":"scene-match-choose-development-target","textbookRevision":1}]}
