olor":"#66869d","lw":1,"op":0.8,"pts":[{"x":770,"y":177},{"x":860,"y":193}]}],"equipment":[]},"dur":1.3,"hold":2.5,"cap":"전진 · 알바레스 역할의 선수가 다음 전진자를 잇는 중간 출구가 됩니다."},{"snap":{"pitchSpec":"fifa","orientation":"h","area":"full","pitchView":"full","pvSide":"own","fieldMode":"standard","spFlip":false,"pitchN":1,"pitchTheme":"train","label":"num","lines":true,"gridType":"off","tokenScale":1.5,"tokV":2,"tokShape":"circle","players":[{"id":1,"team":"blue","num":"A","pos":"","x":300,"y":480,"color":null},{"id":2,"team":"blue","num":"B","pos":"","x":453,"y":410,"color":null},{"id":3,"team":"blue","num":"C","pos":"","x":623,"y":503,"color":null},{"id":4,"team":"blue","num":"D","pos":"","x":714,"y":466,"color":null},{"id":5,"team":"blue","num":"E","pos":"","x":860,"y":193,"color":null},{"id":6,"team":"red","num":"X","pos":"","x":827,"y":337,"color":null},{"id":7,"team":"red","num":"Y","pos":"","x":870,"y":437,"color":null},{"id":8,"team":"red","num":"Z","pos":"","x":500,"y":477,"color":null}],"ball":{"x":730,"y":450,"scale":0.38},"drawings":[{"type":"pass","color":"#b48018","lw":1,"op":1,"pts":[{"x":730,"y":450},{"x":950,"y":210}]},{"type":"run","color":"#66869d","lw":1,"op":0.8,"pts":[{"x":623,"y":503},{"x":650,"y":500}]},{"type":"run","color":"#66869d","lw":1,"op":0.8,"pts":[{"x":714,"y":466},{"x":850,"y":400}]},{"type":"run","color":"#66869d","lw":1,"op":0.8,"pts":[{"x":860,"y":193},{"x":934,"y":226}]}],"equipment":[]},"dur":1.3,"hold":2.5,"cap":"지원 분리 · 맥 알리스테르 역할은 공을 받아 전진하고 먼 쪽 도착자는 폭을 남깁니다."},{"snap":{"pitchSpec":"fifa","orientation":"h","area":"full","pitchView":"full","pvSide":"own","fieldMode":"standard","spFlip":false,"pitchN":1,"pitchTheme":"train","label":"num","lines":true,"gridType":"off","tokenScale":1.5,"tokV":2,"tokShape":"circle","players":[{"id":1,"team":"blue","num":"A","pos":"","x":300,"y":480,"color":null},{"id":2,"team":"blue","num":"B","pos":"","x":470,"y":420,"color":null},{"id":3,"team":"blue","num":"C","pos":"","x":650,"y":500,"color":null},{"id":4,"team":"blue","num":"D","pos":"","x":850,"y":400,"color":null},{"id":5,"team":"blue","num":"E","pos":"","x":934,"y":226,"color":null},{"id":6,"team":"red","num":"X","pos":"","x":900,"y":330,"color":null},{"id":7,"team":"red","num":"Y","pos":"","x":930,"y":420,"color":null},{"id":8,"team":"red","num":"Z","pos":"","x":520,"y":470,"color":null}],"ball":{"x":950,"y":210,"scale":0.38},"drawings":[],"equipment":[]},"dur":1.3,"hold":2.5,"cap":"마지막 선택 · 디 마리아 역할의 선수에게 연결할 각도가 열리는지 확인합니다."}],"animIdx":0,"folder":"교과서 · 실제 경기 학습","tags":["교과서","경기 사례","학습 도식"],"overview":"공식 경기 분석을 바탕으로 PROCESS가 만든 학습용 관계 도식입니다. 필요한 선수만 표시했으며 문자 표시는 등번호가 아닙니다. 위치·거리·이동 시간과 패스 경로는 실측 재현이 아닙니다. 마지막 단계의 검토와 조건 비교는 학습 질문입니다.","method":"아르헨티나축구협회 보고서는 두 번째 골의 연결을 몰리나→메시→알바레스→맥 알리스테르→디 마리아 순서로 설명합니다. 빠른 터치로 전진한 뒤 맥 알리스테르의 마지막 패스를 디 마리아가 골키퍼 앞에서 마무리했습니다.\n\n이 전개를 읽을 때 한 선수의 장거리 질주만 강조하면 패스 출구를 차례로 제공한 동료들이 사라집니다. 아래 도식은 해당 연결의 역할을 단순화한 것으로, 선수의 실제 좌표와 이동 시간을 추적한 자료는 아닙니다.\n\n학습 단계\n1. 탈출 · 몰리나–메시 역할의 가까운 연결로 첫 압박을 벗어나는 길을 표시합니다.\n2. 전진 · 알바레스 역할의 선수가 다음 전진자를 잇는 중간 출구가 됩니다.\n3. 지원 분리 · 맥 알리스테르 역할은 공을 받아 전진하고 먼 쪽 도착자는 폭을 남깁니다.\n4. 마지막 선택 · 디 마리아 역할의 선수에게 연결할 각도가 열리는지 확인합니다.","coaching":"PROCESS 비교 실습\n중앙 수비가 볼 소유자에게 나온다 → 먼 쪽 도착자를 넓게 유지한다 → 수비가 떠난 길을 사용할 수 있는가\n\n첫 전진 패스가 지연된다 → 앞선 주자 한 명이 가까운 지원으로 돌아온다 → 모두 달려가 버려 탈환자가 고립되지 않는가\n\n4v3 역습을 두 출발 위치에서 번갈아 시작합니다. 공격은 가까운 연결·깊이·먼 쪽의 역할을 자유롭게 나누고, 수비는 중앙을 지키거나 볼에 먼저 접근합니다. 마지막 패스 성공 외에 첫 탈출 가능 여부와 서로 다른 출구의 개수를 함께 관찰합니다.","source":{"url":"https://www.afa.com.ar/30/posts/la-seleccion-argentina-ira-en-busca-de-la-gloria-en-la-final-del-mundo-ante-francia","fixture":"아르헨티나 3–3 프랑스 · 승부차기 4–2","date":"2022-12-18","locator":"AFA 경기 보고서 · El segundo golpe, 아르헨티나의 두 번째 골","article":"https://weloveprocess.netlify.app/focus/counterattack-support/","scene":"match-counterattack-support"},"textbookItem":"scene-match-counterattack-support","textbookRevision":1}]}
