{"x":485,"y":168.4},{"x":541,"y":174}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":807,"y":358.8},{"x":793,"y":470.8}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":506,"y":330.8},{"x":520,"y":258}]}],"equipment":[]},"cap":"조정 · B2가 받을 때 B3는 다른 각도에서 다음 길을 제공합니다.","hold":2.5,"dur":1.3},{"snap":{"pitchSpec":"grid30","orientation":"h","area":"full","pitchView":"full","pvSide":"own","fieldMode":"standard","spFlip":false,"pitchN":1,"pitchTheme":"train","label":"num","lines":true,"gridType":"off","tokenScale":1.2,"teamColors":{"blue":"#234f83","red":"#b54c46","yellow":"#b38c35"},"gkColors":{"blue":"#234f83","red":"#b54c46"},"teamTxtC":{"blue":"#ffffff","red":"#ffffff","yellow":"#ffffff"},"chip3d":false,"tokV":2,"tokShape":"circle","players":[{"id":1,"num":"B1","team":"blue","pos":"","color":null,"x":289,"y":370},{"id":2,"num":"B2","team":"blue","pos":"","color":null,"x":485,"y":168.4},{"id":3,"num":"B3","team":"blue","pos":"","color":null,"x":807,"y":358.8},{"id":4,"num":"B4","team":"blue","pos":"","color":null,"x":429,"y":538},{"id":5,"num":"R1","team":"red","pos":"","color":null,"x":506,"y":330.8},{"id":6,"num":"R2","team":"red","pos":"","color":null,"x":660,"y":510}],"ball":{"x":446,"y":555,"scale":0.38},"drawings":[{"type":"rectline","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":205,"y":90},{"x":905,"y":650}]},{"type":"line","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":555,"y":90},{"x":555,"y":650}]},{"type":"pass","color":"#234f83","lw":1,"op":1,"pts":[{"x":429,"y":538},{"x":289,"y":370}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":541,"y":566},{"x":429,"y":538}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":639,"y":437.2},{"x":660,"y":510}]}],"equipment":[]},"cap":"다른 조건 · B4가 아래에서 받으면 B1에게 돌아가는 길도 선택입니다. 수비가 이 길을 좁히면 다른 지원을 찾습니다.","hold":2.5,"dur":1.3}],"overview":"선수·공·이동은 원리를 설명하기 위한 가상 배치입니다. 세 그림은 학습용 조건 비교이며 실제 경기의 좌표·거리·시간을 측정한 자료가 아닙니다. 각 그림의 흰 공은 첫 실선 패스의 출발점이고, 실선은 가능한 패스 연결, 점선은 기본 배치에서 바뀐 선수 위치를 뜻합니다. 세 그림을 끊김 없는 연속 장면으로 읽지 않습니다. 구체적인 운영은 연결된 공통 훈련 카드를 따릅니다.\n\n목표: 수신자가 압박받기 전에 서로 다른 패스 길을 만든다.","setup":"20×16m 직사각형. 파랑 4명과 빨강 2명이 모두 안에서 움직입니다. 고정된 모서리 자리는 없습니다.\n준비물: 공 4개, 경계 콘 4개, 조끼 두 색. 코치와 예비 공은 긴 변 바깥에 둡니다.","method":"시작: 코치가 파랑 중 한 명에게 공을 넣으면 시작합니다. 빨강은 패스와 운반에 자유롭게 대응합니다.\n\n파랑은 6회 연속 패스하면 1점입니다. 같은 두 선수의 반복 패스도 허용하지만 지원 관계를 관찰합니다.\n빨강이 되찾으면 경계 밖으로 공을 운반할 때 1점입니다. 파랑은 즉시 길을 막거나 회수할 수 있습니다.\n득점·아웃이면 멈추고 코치가 새 공을 파랑에게 넣습니다. 이전 공을 먼저 치워 두 공이 섞이지 않게 합니다.\n이 축소 게임은 오프사이드를 적용하지 않습니다. 실제 경기의 최종 수비선과 출발 시점은 별도로 확인합니다.\n반칙은 피해 팀의 해당 지점 간접 프리킥으로 재개하며 상대는 3m 떨어집니다.\n\n각 세트 뒤 빨강 2명을 교체합니다. 첫 세트 1·2번, 다음 3·4번, 다음 5·6번이 수비하고 마지막은 경험이 적었던 역할을 보완합니다.","coaching":"수비 한 명이 두 길을 가린다 → 첫 패스 직전으로 되돌려 “받은 뒤 어느 길이 남나?”라고 묻고 한 선수만 각도를 바꿔 다시 합니다.\n\n패스 뒤 모두 앞으로 달린다 → 돌아올 길을 누가 남길지 정한 뒤 수비의 선택은 자유롭게 둡니다.","func":"관찰: 표본 수신 6회를 골라 수신 직전 열린 연결이 있었는지, 실제 다음 행동이 가능했는지 각각 기록합니다.\n\n전이: 방향 있는 D02로 옮겨 같은 지원이 전진에도 도움이 되는지 확인합니다.","prog":"쉽게: 공간을 24×18m로 넓힙니다. 인원과 규칙은 유지해 공간 변화의 영향만 봅니다.\n\n어렵게: 선택 변형: 6회 패스 점수를 없애고 두 팀 모두 열린 경계로 공을 통제하며 운반하면 1점으로 바꿉니다. 득점·아웃 뒤에는 기본안처럼 코치가 파랑에게 넣습니다. 패스 수 중심 과제와 다른 판단을 요구하는 변형입니다.","minutes":3,"sets":4,"source":{"url":"https://weloveprocess.netlify.app/textbook/practice/d01/","scene":"d01"},"trainingArea":{"width":20,"height":16},"textbookItem":"scene-d01","textbookRevision":2,"animIdx":0}]}
