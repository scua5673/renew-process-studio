6}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":453,"y":397},{"x":507,"y":334}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":633,"y":235},{"x":675,"y":226}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":549,"y":280},{"x":531,"y":293.5}]}],"equipment":[]},"cap":"선택 A · 앞이 열리고 동료가 준비됐다면 회복 뒤 전진할 수 있습니다.","hold":2.5,"dur":1.3},{"snap":{"pitchSpec":"grid70","orientation":"h","area":"full","pitchView":"full","pvSide":"own","fieldMode":"standard","spFlip":false,"pitchN":1,"pitchTheme":"train","label":"num","lines":true,"gridType":"off","tokenScale":1.2,"teamColors":{"blue":"#234f83","red":"#b54c46","yellow":"#b38c35"},"gkColors":{"blue":"#234f83","red":"#b54c46"},"teamTxtC":{"blue":"#ffffff","red":"#ffffff","yellow":"#ffffff"},"chip3d":false,"tokV":2,"tokShape":"circle","players":[{"id":1,"num":"B1","team":"blue","pos":"","color":null,"x":405,"y":302.5},{"id":2,"num":"B2","team":"blue","pos":"","color":null,"x":507,"y":334},{"id":3,"num":"B3","team":"blue","pos":"","color":null,"x":633,"y":235},{"id":4,"num":"B4","team":"blue","pos":"","color":null,"x":627,"y":496},{"id":5,"num":"R1","team":"red","pos":"","color":null,"x":549,"y":280},{"id":6,"num":"R2","team":"red","pos":"","color":null,"x":573,"y":406},{"id":7,"num":"R3","team":"red","pos":"","color":null,"x":675,"y":253},{"id":8,"num":"R4","team":"red","pos":"","color":null,"x":711,"y":473.5},{"id":9,"num":"GK1","team":"blue","pos":"GK","color":"#263b31","x":279,"y":370},{"id":10,"num":"GK2","team":"red","pos":"GK","color":"#263b31","x":831,"y":370}],"ball":{"x":524,"y":351,"scale":0.38},"drawings":[{"type":"rectline","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":255,"y":145},{"x":855,"y":595}]},{"type":"line","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":555,"y":145},{"x":555,"y":595}]},{"type":"rectline","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":243,"y":316},{"x":255,"y":424}]},{"type":"rectline","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":255,"y":235},{"x":399,"y":505}]},{"type":"rectline","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":855,"y":316},{"x":867,"y":424}]},{"type":"rectline","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":711,"y":235},{"x":855,"y":505}]},{"type":"pass","color":"#234f83","lw":1,"op":1,"pts":[{"x":507,"y":334},{"x":279,"y":370}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":453,"y":397},{"x":507,"y":334}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":711,"y":266.5},{"x":675,"y":253}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":399,"y":257.5},{"x":405,"y":302.5}]}],"equipment":[]},"cap":"선택 B · 앞이 닫히면 골키퍼와 확보합니다. A의 필연적인 다음 장면이 아닌 비교 조건입니다.","hold":2.5,"dur":1.3}],"overview":"선수·공·이동은 원리를 설명하기 위한 가상 배치입니다. 세 그림은 학습용 조건 비교이며 실제 경기의 좌표·거리·시간을 측정한 자료가 아닙니다. 구체적인 운영은 아래 훈련 카드를 따릅니다.\n\n목표: 탈취 직후 열린 길과 동료의 준비를 보고 역습과 소유를 고른다.","setup":"각 팀 필드 4명+골키퍼 1명, 총 10명입니다. 골키퍼도 소유를 확보하는 연결에 참여합니다.\n준비물: 골대 2개, 공 6개, 세로 참고 구역 콘.","method":"시작: 코치가 한 팀의 중앙 선수에게 넣고 상대는 자유롭게 압박합니다. 다음 시작은 반대 팀에 줍니다.\n\n탈취 직후 빠른 득점에 추가 점수를 주지 않습니다. 모든 득점은 1점입니다.\n앞이 막히면 옆이나 자기 골키퍼에게 연결할 수 있습니다. 전진을 선택한 경우 그 뒤 지원도 계속합니다.\n터치라인 아웃은 킥인, 골라인 아웃은 골키퍼, 득점 뒤는 실점 팀 골키퍼에게서 시작합니다. 오프사이드는 적용하지 않습니다.\n\n두 세트 뒤 진영을 바꾸고 가장 앞·뒤 역할의 필드 선수 한 쌍을 교환합니다.","coaching":"되찾자마자 보지 않고 찬다 → 첫 터치 전에 전방·가까운 지원·압박 방향 중 무엇을 확인했는지 묻습니다.\n\n앞이 열렸는데 항상 뒤로만 준다 → 실패를 피하려는 습관인지 지원이 늦었는지 선수의 설명과 장면을 함께 봅니다.","func":"관찰: 회복 당시 전방 길·압박·지원, 선택과 그 뒤 두 행동을 묶어 기록합니다.\n\n전이: 역습 득점 사례와 안전하게 확보한 사례를 함께 찾아 다음 기회에서도 선택할 기준을 말하게 합니다.","prog":"쉽게: 공간을 44×32m로 넓혀 첫 판단 시간을 줍니다.\n\n어렵게: 재시작 위치를 측면과 자기 골문 가까이로 바꿉니다. 판단 시간 제한은 추가하지 않습니다.","minutes":3,"sets":4,"source":{"url":"https://weloveprocess.netlify.app/textbook/practice/d15/","scene":"d15"},"trainingArea":{"width":40,"height":30},"textbookItem":"scene-d15","textbookRevision":1,"animIdx":0}]}
