"pos":"","x":780,"y":300,"color":null},{"id":6,"team":"red","num":"Y","pos":"","x":850,"y":440,"color":null}],"ball":{"x":460,"y":390,"scale":0.38},"drawings":[{"type":"pass","color":"#b48018","lw":1,"op":1,"pts":[{"x":460,"y":390},{"x":580,"y":270}]},{"type":"run","color":"#66869d","lw":1,"op":0.8,"pts":[{"x":444,"y":406},{"x":560,"y":370}]},{"type":"run","color":"#66869d","lw":1,"op":0.8,"pts":[{"x":750,"y":430},{"x":680,"y":430}]},{"type":"run","color":"#66869d","lw":1,"op":0.8,"pts":[{"x":520,"y":260},{"x":564,"y":286}]},{"type":"run","color":"#66869d","lw":1,"op":0.8,"pts":[{"x":740,"y":580},{"x":767,"y":563}]}],"equipment":[]},"dur":1.3,"hold":2.5,"cap":"역할 A · 케인 유형의 수신자가 내려와 동료가 전진할 연결점을 만듭니다."},{"snap":{"pitchSpec":"fifa","orientation":"h","area":"full","pitchView":"full","pvSide":"own","fieldMode":"standard","spFlip":false,"pitchN":1,"pitchTheme":"train","label":"num","lines":true,"gridType":"off","tokenScale":1.5,"tokV":2,"tokShape":"circle","players":[{"id":1,"team":"blue","num":"A","pos":"","x":560,"y":370,"color":null},{"id":2,"team":"blue","num":"B","pos":"","x":680,"y":430,"color":null},{"id":3,"team":"blue","num":"C","pos":"","x":564,"y":286,"color":null},{"id":4,"team":"blue","num":"D","pos":"","x":767,"y":563,"color":null},{"id":5,"team":"red","num":"X","pos":"","x":760,"y":300,"color":null},{"id":6,"team":"red","num":"Y","pos":"","x":880,"y":440,"color":null}],"ball":{"x":580,"y":270,"scale":0.38},"drawings":[{"type":"pass","color":"#b48018","lw":1,"op":1,"pts":[{"x":580,"y":270},{"x":760,"y":460}]},{"type":"run","color":"#66869d","lw":1,"op":0.8,"pts":[{"x":560,"y":370},{"x":600,"y":370}]},{"type":"run","color":"#66869d","lw":1,"op":0.8,"pts":[{"x":680,"y":430},{"x":744,"y":476}]},{"type":"run","color":"#66869d","lw":1,"op":0.8,"pts":[{"x":767,"y":563},{"x":793,"y":547}]}],"equipment":[]},"dur":1.3,"hold":2.5,"cap":"역할 B · 왓킨스 역할의 주자는 짧게 보인 뒤 수비선 뒤를 위협합니다."},{"snap":{"pitchSpec":"fifa","orientation":"h","area":"full","pitchView":"full","pvSide":"own","fieldMode":"standard","spFlip":false,"pitchN":1,"pitchTheme":"train","label":"num","lines":true,"gridType":"off","tokenScale":1.5,"tokV":2,"tokShape":"circle","players":[{"id":1,"team":"blue","num":"A","pos":"","x":600,"y":370,"color":null},{"id":2,"team":"blue","num":"B","pos":"","x":744,"y":476,"color":null},{"id":3,"team":"blue","num":"C","pos":"","x":560,"y":267,"color":null},{"id":4,"team":"blue","num":"D","pos":"","x":793,"y":547,"color":null},{"id":5,"team":"red","num":"X","pos":"","x":740,"y":300,"color":null},{"id":6,"team":"red","num":"Y","pos":"","x":880,"y":450,"color":null}],"ball":{"x":760,"y":460,"scale":0.38},"drawings":[{"type":"shot","color":"#b48018","lw":1,"op":1,"pts":[{"x":760,"y":460},{"x":1010,"y":370}]},{"type":"run","color":"#66869d","lw":1,"op":0.8,"pts":[{"x":600,"y":370},{"x":640,"y":360}]},{"type":"run","color":"#66869d","lw":1,"op":0.8,"pts":[{"x":744,"y":476},{"x":940,"y":410}]},{"type":"run","color":"#66869d","lw":1,"op":0.8,"pts":[{"x":793,"y":547},{"x":820,"y":530}]}],"equipment":[]},"dur":1.3,"hold":2.5,"cap":"지원 · 파머 역할의 패서가 수비의 시선을 나누며 침투자를 찾습니다."},{"snap":{"pitchSpec":"fifa","orientation":"h","area":"full","pitchView":"full","pvSide":"own","fieldMode":"standard","spFlip":false,"pitchN":1,"pitchTheme":"train","label":"num","lines":true,"gridType":"off","tokenScale":1.5,"tokV":2,"tokShape":"circle","players":[{"id":1,"team":"blue","num":"A","pos":"","x":640,"y":360,"color":null},{"id":2,"team":"blue","num":"B","pos":"","x":940,"y":410,"color":null},{"id":3,"team":"blue","num":"C","pos":"","x":580,"y":270,"color":null},{"id":4,"team":"blue","num":"D","pos":"","x":820,"y":530,"color":null},{"id":5,"team":"red","num":"X","pos":"","x":720,"y":300,"color":null},{"id":6,"team":"red","num":"Y","pos":"","x":970,"y":400,"color":null}],"ball":{"x":1010,"y":370,"scale":0.38},"drawings":[],"equipment":[]},"dur":1.3,"hold":2.5,"cap":"기록 · 연결 수신과 뒤 침투를 다른 경험으로 구분해 다음 계획에 남깁니다."}],"animIdx":0,"folder":"교과서 · 실제 경기 학습","tags":["교과서","경기 사례","학습 도식"],"overview":"공식 경기 분석을 바탕으로 PROCESS가 만든 학습용 관계 도식입니다. 필요한 선수만 표시했으며 문자 표시는 등번호가 아닙니다. 위치·거리·이동 시간과 패스 경로는 실측 재현이 아닙니다. 마지막 단계의 검토와 조건 비교는 학습 질문입니다. 서로 다른 역할의 비교 도식입니다. 케인과 왓킨스의 동시 출전 장면을 재현하지 않습니다.","method":"UEFA 분석에 따르면 81분에 투입된 왓킨스는 뒤로 향하는 달리기를 반복했고, 파머의 패스를 받아 결승골을 만들었습니다. 분석은 케인이 라인 사이에서 받아 동료의 침투를 돕는 역할과 왓킨스의 뒷공간 움직임을 구별했습니다.\n\n기사의 비교에서 왓킨스는 추가시간을 포함한 약 15분 동안 케인의 81분과 같은 수의 뒷공간 달리기를 기록했습니다. 출전 시간만으로 두 선수가 경험한 모든 요구를 동일하게 설명하기 어렵다는 사례이며, 피로 수준이 같다는 뜻은 아닙니다.\n\n학습 단계\n1. 역할 A · 케인 유형의 수신자가 내려와 동료가 전진할 연결점을 만듭니다.\n2. 역할 B · 왓킨스 역할의 주자는 짧게 보인 뒤 수비선 뒤를 위협합니다.\n3. 지원 · 파머 역할의 패서가 수비의 시선을 나누며 침투자를 찾습니다.\n4. 기록 · 연결 수신과 뒤 침투를 다른 경험으로 구분해 다음 계획에 남깁니다.","coaching":"PROCESS 비교 실습\n출전은 짧지만 강한 침투가 반복됐다 → 보충 여부를 출전 시간만으로 정하지 않고 반응과 기록을 확인한다 → 부족한 기술 경험과 추가 신체 요구를 구분했는가\n\n출전은 길지만 다음 역할이 바뀐다 → 짧고 구체적인 역할 미팅이나 제한된 실습을 더한다 → 피로를 늘리기보다 필요한 정보를 학습할 수 있는가\n\nStudio에 선수별로 출전 시간·역할·관찰한 행동·선수 반응의 네 칸을 남깁니다. 다음 세션은 공통 공격 원칙을 유지하면서 수신자와 침투자의 역할을 나눕니다. 실제 참여량과 회복 상태를 확인한 뒤 반복을 조정하고, 경기 기록만으로 개인의 건강 상태나 적정 부하를 판정하지 않습니다.","source":{"url":"https://www.uefa.com/uefaeuro/history/news/028f-1b5765a3842e-a4a706ebc266-1000--netherlands-1-2-england-analysis-how-ollie-watkins-impacted/","fixture":"네덜란드 1–2 잉글랜드","date":"2024-07-10","locator":"Tactical analysis: Watkins’ instant impact · 교체 뒤 침투와 결승골","article":"https://weloveprocess.netlify.app/focus/individualise-the-week/","scene":"match-individualise-the-week"},"textbookItem":"scene-match-individualise-the-week","textbookRevision":1}]}
