team":"yellow","pos":"","color":null,"x":909.2,"y":370}],"ball":{"x":356.4,"y":303,"scale":0.38},"drawings":[{"type":"rectline","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":170,"y":90},{"x":940,"y":650}]},{"type":"line","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":555,"y":90},{"x":555,"y":650}]},{"type":"dashline","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":231.6,"y":90},{"x":231.6,"y":650}]},{"type":"dashline","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":878.4,"y":90},{"x":878.4,"y":650}]},{"type":"pass","color":"#234f83","lw":1,"op":1,"pts":[{"x":339.4,"y":286},{"x":493.4,"y":493.2}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":632,"y":314},{"x":524.2,"y":314}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":724.4,"y":482},{"x":678.2,"y":426}]}],"equipment":[]},"cap":"조정 · R1이 접근하는 동안 R2는 다음 패스와 돌파를 준비합니다.","hold":2.5,"dur":1.3},{"snap":{"pitchSpec":"grid30","orientation":"h","area":"full","pitchView":"full","pvSide":"own","fieldMode":"standard","spFlip":false,"pitchN":1,"pitchTheme":"train","label":"num","lines":true,"gridType":"off","tokenScale":1.2,"teamColors":{"blue":"#234f83","red":"#b54c46","yellow":"#b38c35"},"gkColors":{"blue":"#234f83","red":"#b54c46"},"teamTxtC":{"blue":"#ffffff","red":"#ffffff","yellow":"#ffffff"},"chip3d":false,"tokV":2,"tokShape":"circle","players":[{"id":1,"num":"B1","team":"blue","pos":"","color":null,"x":339.4,"y":286},{"id":2,"num":"B2","team":"blue","pos":"","color":null,"x":624.3,"y":532.4},{"id":3,"num":"R1","team":"red","pos":"","color":null,"x":562.7,"y":442.8},{"id":4,"num":"R2","team":"red","pos":"","color":null,"x":770.6,"y":515.6},{"id":5,"num":"N1","team":"yellow","pos":"","color":null,"x":200.8,"y":370},{"id":6,"num":"N2","team":"yellow","pos":"","color":null,"x":909.2,"y":370}],"ball":{"x":641.3,"y":549.4,"scale":0.38},"drawings":[{"type":"rectline","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":170,"y":90},{"x":940,"y":650}]},{"type":"line","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":555,"y":90},{"x":555,"y":650}]},{"type":"dashline","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":231.6,"y":90},{"x":231.6,"y":650}]},{"type":"dashline","color":"#8b98a9","lw":1,"op":1,"pts":[{"x":878.4,"y":90},{"x":878.4,"y":650}]},{"type":"pass","color":"#234f83","lw":1,"op":1,"pts":[{"x":624.3,"y":532.4},{"x":909.2,"y":370}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":493.4,"y":493.2},{"x":624.3,"y":532.4}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":632,"y":314},{"x":562.7,"y":442.8}]},{"type":"run","color":"#607467","lw":1,"op":1,"pts":[{"x":724.4,"y":482},{"x":770.6,"y":515.6}]}],"equipment":[]},"cap":"패스 이후 · 공이 옮겨 가면 첫 접근과 커버의 담당도 바뀝니다.","hold":2.5,"dur":1.3}],"overview":"선수·공·이동은 원리를 설명하기 위한 가상 배치입니다. 세 그림은 학습용 조건 비교이며 실제 경기의 좌표·거리·시간을 측정한 자료가 아닙니다. 구체적인 운영은 아래 훈련 카드를 따릅니다.\n\n목표: 첫 수비수가 상대를 늦추는 동안 두 번째 수비수가 다음 위험을 준비한다.","setup":"가운데 파랑 2·빨강 2, 끝 중립 1명씩으로 총 6명입니다. 중립은 구역 밖으로 나오지 않습니다.\n준비물: 공 4개, 양 끝 2m 중립 구역, 조끼 세 색.","method":"시작: 한쪽 중립이 파랑에게 넣고, 파랑은 반대 중립을 목표로 합니다. 다음 시작은 빨강입니다.\n\n상대 끝 중립에게 통제 가능한 패스를 연결하면 1점입니다. 돌아올 중립도 사용할 수 있습니다.\n탈취 즉시 반대 끝으로 공격합니다. 태클 횟수에 점수를 주지 않습니다.\n아웃은 반대 팀이 자기 끝 중립에게서 시작합니다. 중립 수신으로 점수가 나면 양 팀의 공격 방향을 뒤집고 같은 팀이 이어갑니다.\n\n중립 2명은 매 세트 중앙 선수 2명과 교대합니다. 첫 수비와 커버를 둘 다 경험하도록 시작 위치를 바꿉니다.","coaching":"둘이 같은 속도로 공에 달린다 → 첫 접근자 뒤에 누가 어떤 패스를 막을지 확인합니다. 접근 거리는 상대의 공 상태에 맞춥니다.\n\n돌파당한 선수가 멈춘다 → 동료가 공을 맡은 뒤 자신이 어떤 길을 다시 막을 수 있는지 묻습니다.","func":"관찰: 첫 접근 방향·커버 도착·돌파 이후 역할 전환을 기록합니다.\n\n전이: 골문과 주변 동료가 있는 실제 장면에서 유도 방향을 다시 판단합니다.","prog":"쉽게: 공간을 18×16m로 줄여 커버가 가까이 도울 조건을 만듭니다.\n\n어렵게: 한 수비수를 3m 뒤에서 출발시켜 첫 수비수가 지원이 올 때까지 지연하게 합니다.","minutes":2,"sets":4,"source":{"url":"https://weloveprocess.netlify.app/textbook/practice/d09/","scene":"d09"},"trainingArea":{"width":22,"height":16},"textbookItem":"scene-d09","textbookRevision":1,"animIdx":0}]}
