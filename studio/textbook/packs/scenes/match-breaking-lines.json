num":"D","pos":"","x":604,"y":386,"color":null},{"id":5,"team":"blue","num":"E","pos":"","x":780,"y":453,"color":null},{"id":6,"team":"red","num":"X","pos":"","x":443,"y":260,"color":null},{"id":7,"team":"red","num":"Y","pos":"","x":453,"y":470,"color":null},{"id":8,"team":"red","num":"Z","pos":"","x":800,"y":340,"color":null}],"ball":{"x":620,"y":370,"scale":0.38},"drawings":[{"type":"pass","color":"#b48018","lw":1,"op":1,"pts":[{"x":620,"y":370},{"x":760,"y":450}]},{"type":"run","color":"#66869d","lw":1,"op":0.8,"pts":[{"x":387,"y":470},{"x":350,"y":470}]},{"type":"run","color":"#66869d","lw":1,"op":0.8,"pts":[{"x":604,"y":386},{"x":690,"y":410}]},{"type":"run","color":"#66869d","lw":1,"op":0.8,"pts":[{"x":780,"y":453},{"x":744,"y":466}]}],"equipment":[]},"dur":1.3,"hold":2.5,"cap":"전진 · 시몬 역할의 패서가 올모 역할의 수신자를 직접 찾는 길을 표시합니다."},{"snap":{"pitchSpec":"fifa","orientation":"h","area":"full","pitchView":"full","pvSide":"own","fieldMode":"standard","spFlip":false,"pitchN":1,"pitchTheme":"train","label":"num","lines":true,"gridType":"off","tokenScale":1.5,"tokV":2,"tokShape":"circle","players":[{"id":1,"team":"blue","num":"A","pos":"","x":130,"y":370,"color":null},{"id":2,"team":"blue","num":"B","pos":"","x":340,"y":280,"color":null},{"id":3,"team":"blue","num":"C","pos":"","x":350,"y":470,"color":null},{"id":4,"team":"blue","num":"D","pos":"","x":690,"y":410,"color":null},{"id":5,"team":"blue","num":"E","pos":"","x":744,"y":466,"color":null},{"id":6,"team":"red","num":"X","pos":"","x":410,"y":260,"color":null},{"id":7,"team":"red","num":"Y","pos":"","x":420,"y":470,"color":null},{"id":8,"team":"red","num":"Z","pos":"","x":800,"y":340,"color":null}],"ball":{"x":760,"y":450,"scale":0.38},"drawings":[],"equipment":[]},"dur":1.3,"hold":2.5,"cap":"다음 행동 · 수신자의 몸 방향과 가까운 지원을 붙여 패스 이후까지 읽습니다."}],"animIdx":0,"folder":"교과서 · 실제 경기 학습","tags":["교과서","경기 사례","학습 도식"],"overview":"공식 경기 분석을 바탕으로 PROCESS가 만든 학습용 관계 도식입니다. 필요한 선수만 표시했으며 문자 표시는 등번호가 아닙니다. 위치·거리·이동 시간과 패스 경로는 실측 재현이 아닙니다. 마지막 단계의 검토와 조건 비교는 학습 질문입니다.","method":"UEFA 분석에 따르면 전반의 스페인은 잉글랜드의 대인 대응과 좁은 간격 때문에 중앙 전진에 어려움을 겪었습니다. 후반에는 파비안 루이스가 수비형 미드필더 수비멘디 옆으로 내려오며 중원의 관계가 달라졌습니다.\n\n분석 도식에는 잉글랜드 미드필더들이 낮아진 두 선수를 향해 올라간 사이, 우나이 시몬이 라인 사이의 다니 올모를 찾는 장면이 나옵니다. 올모가 받은 라인 브레이킹 패스는 전반 1회에서 후반 5회로 늘었습니다.\n\n학습 단계\n1. 준비 · 낮은 연결자 두 명과 라인 사이 수신자 한 명의 높이를 구분합니다.\n2. 상대 반응 · 앞선 두 선수가 낮은 연결자에게 나가면 뒤의 통로가 어떻게 바뀌는지 봅니다.\n3. 전진 · 시몬 역할의 패서가 올모 역할의 수신자를 직접 찾는 길을 표시합니다.\n4. 다음 행동 · 수신자의 몸 방향과 가까운 지원을 붙여 패스 이후까지 읽습니다.","coaching":"PROCESS 비교 실습\n상대가 두 연결자에게 따라 나온다 → 올모 역할의 선수를 그 뒤의 다른 높이에 둔다 → 수신자가 상대 시야 밖에서 전방을 볼 수 있는가\n\n상대가 중앙을 지키며 나오지 않는다 → 낮은 연결자의 운반 또는 측면 전진을 허용한다 → 중앙 패스를 강요하지 않고 열린 공간을 사용하는가\n\n골키퍼를 포함한 후방 3명과 중원 3명이 두 줄의 수비를 통과하는 방향성 게임으로 시작합니다. 수비는 낮은 연결자에게 나가거나 공간을 지킬 수 있습니다. 공격 성공은 단순한 패스 통과가 아니라 수신 뒤 전방 연결까지로 정하고, 공을 잃으면 수비가 즉시 반격하도록 합니다.","source":{"url":"https://www.uefa.com/uefaeuro/history/news/028f-1b61d5b4684d-b749da0e172a-1000--spain-2-1-england-uefa-euro-2024-final-analysis/","fixture":"스페인 2–1 잉글랜드","date":"2024-07-14","locator":"후반 중원 2+1 배치 도식 · 시몬에서 올모로 향하는 연결","article":"https://weloveprocess.netlify.app/focus/breaking-lines/","scene":"match-breaking-lines"},"textbookItem":"scene-match-breaking-lines","textbookRevision":1}]}
